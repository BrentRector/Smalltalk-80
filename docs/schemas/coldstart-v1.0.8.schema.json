{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/YourOrg/Smalltalk-80/schemas/coldstart/v1.0.8",
    "title": "Smalltalk-80 ColdStart Image Schema v1.0.8",
    "description": "Schema for deterministic Smalltalk-80 cold-start bundles. v1.0.8 adds pool variable reference tracking and dependency graph metadata for canonical init ordering.",
    "type": "object",
    "required": [
        "metadata",
        "symbols",
        "strings",
        "optimizedSelectors",
        "classes",
        "objects",
        "methods",
        "initExpressions",
        "installOrder",
        "patches",
        "poolDependencyGraph"
    ],
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "type": "object",
            "required": [
                "version",
                "generator",
                "generatedAt",
                "sourceChecksum"
            ],
            "properties": {
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "generator": {
                    "type": "string"
                },
                "generatedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "sourceFile": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "sourceChecksum": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "symbolCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "stringCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "classCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "methodCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "objectCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "initExpressionCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "undeclaredCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "symbols": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 1
        },
        "strings": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 0
        },
        "optimizedSelectors": {
            "type": "array",
            "items": {
                "type": "integer",
                "minimum": 0
            },
            "maxItems": 32,
            "uniqueItems": true
        },
        "classes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "localId",
                    "nameIndex",
                    "isMetaclass",
                    "format",
                    "instVarNames",
                    "classVarNames",
                    "poolLocalIds",
                    "category",
                    "totalInstanceVarCount",
                    "fieldLayout"
                ],
                "properties": {
                    "localId": {
                        "type": "string"
                    },
                    "nameIndex": {
                        "type": "integer"
                    },
                    "isMetaclass": {
                        "type": "boolean"
                    },
                    "metaclassOfLocalId": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "format": {
                        "type": "integer"
                    },
                    "instVarNames": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "classVarNames": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "poolLocalIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "superNameIndex": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "category": {
                        "type": "string"
                    },
                    "commentStringIndex": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "classSideInitMethodLocalId": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "notes": {
                        "type": "string"
                    },
                    "totalInstanceVarCount": {
                        "type": "integer"
                    },
                    "fieldLayout": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "nameIndex",
                                "slotIndex"
                            ],
                            "properties": {
                                "nameIndex": {
                                    "type": "integer"
                                },
                                "slotIndex": {
                                    "type": "integer"
                                },
                                "inheritedFrom": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "objects": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "localId",
                    "classNameIndex",
                    "fields",
                    "indexedFields",
                    "formatHint"
                ],
                "properties": {
                    "localId": {
                        "type": "string"
                    },
                    "classNameIndex": {
                        "type": "integer"
                    },
                    "formatHint": {
                        "type": "string",
                        "enum": [
                            "pointers",
                            "words",
                            "bytes",
                            "compiledMethod",
                            "custom"
                        ]
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/fieldValue"
                        }
                    },
                    "indexedFields": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/fieldValue"
                        }
                    },
                    "notes": {
                        "type": "string"
                    }
                }
            }
        },
        "methods": {
            "type": "array",
            "description": "All compiled methods (both class and instance methods). Compiler provides method localId; loader creates CompiledMethod objects and installs in method dictionaries.",
            "items": {
                "type": "object",
                "required": [
                    "localId",
                    "homeClassLocalId",
                    "selectorIndex",
                    "header",
                    "literals",
                    "bytecodes"
                ],
                "properties": {
                    "localId": {
                        "type": "string"
                    },
                    "homeClassLocalId": {
                        "type": "string"
                    },
                    "selectorIndex": {
                        "type": "integer"
                    },
                    "header": {
                        "$ref": "#/definitions/methodHeader"
                    },
                    "literals": {
                        "type": "array",
                        "description": "Literal frame for this method. Each entry is a discriminated literal.",
                        "items": {
                            "$ref": "#/definitions/literalValue"
                        }
                    },
                    "bytecodes": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "description": "Bytecode array as integer sequence (0-255)"
                    },
                    "poolReferences": {
                        "type": "array",
                        "description": "Pool variable references in this method",
                        "items": {
                            "type": "object",
                            "required": [
                                "poolLocalId",
                                "symbolIndex",
                                "usage"
                            ],
                            "properties": {
                                "poolLocalId": {
                                    "type": "string"
                                },
                                "symbolIndex": {
                                    "type": "integer"
                                },
                                "usage": {
                                    "type": "string",
                                    "enum": [
                                        "consume",
                                        "produce"
                                    ]
                                }
                            }
                        }
                    },
                    "source": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "initExpressions": {
            "type": "array",
            "description": "Top-level initialization expressions (DoIts) to execute during cold start. Each is compiled like a method but has no home class.",
            "items": {
                "type": "object",
                "required": [
                    "localId",
                    "header",
                    "literals",
                    "bytecodes"
                ],
                "properties": {
                    "localId": {
                        "type": "string"
                    },
                    "header": {
                        "$ref": "#/definitions/methodHeader"
                    },
                    "literals": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/literalValue"
                        }
                    },
                    "bytecodes": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        }
                    },
                    "poolReferences": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "poolLocalId",
                                "symbolIndex",
                                "usage"
                            ],
                            "properties": {
                                "poolLocalId": {
                                    "type": "string"
                                },
                                "symbolIndex": {
                                    "type": "integer"
                                },
                                "usage": {
                                    "type": "string",
                                    "enum": [
                                        "consume",
                                        "produce"
                                    ]
                                }
                            }
                        }
                    },
                    "source": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "installOrder": {
            "type": "object",
            "required": [
                "phases"
            ],
            "description": "Deterministic installation sequence. Loader must process in this order to avoid forward-reference issues.",
            "properties": {
                "phases": {
                    "type": "array",
                    "description": "Sequential installation phases. Each phase lists localIds to process.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "kind",
                            "localIds"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "classes",
                                    "objects",
                                    "methods",
                                    "initExpressions",
                                    "patches"
                                ]
                            },
                            "localIds": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "notes": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "patches": {
            "type": "array",
            "description": "Explicit patch operations the loader must apply after allocation. Resolves forward references, circular structures, and Association values.",
            "items": {
                "type": "object",
                "required": [
                    "patchId",
                    "target",
                    "operation",
                    "value"
                ],
                "properties": {
                    "patchId": {
                        "type": "string"
                    },
                    "target": {
                        "type": "object",
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "methodLiteral",
                                    "objectField",
                                    "objectIndexed",
                                    "classSlot",
                                    "metaclassWiring",
                                    "systemDictionary",
                                    "custom"
                                ]
                            },
                            "methodLocalId": {
                                "type": "string"
                            },
                            "literalIndex": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "objectLocalId": {
                                "type": "string"
                            },
                            "fieldIndex": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "indexedSlot": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "classLocalId": {
                                "type": "string"
                            },
                            "slotName": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "setValue",
                            "setAssociationValue",
                            "wireMetaclass",
                            "addToSystemDictionary",
                            "custom"
                        ]
                    },
                    "value": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "type"
                                ],
                                "properties": {
                                    "type": {
                                        "enum": [
                                            "objectRef",
                                            "symbolRef",
                                            "smallInt",
                                            "nil"
                                        ]
                                    },
                                    "localId": {
                                        "type": "string"
                                    },
                                    "symbolIndex": {
                                        "type": "integer"
                                    },
                                    "intValue": {
                                        "type": "integer"
                                    }
                                },
                                "additionalProperties": false
                            }
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "undeclared": {
            "type": "array",
            "description": "Compiler-tracked undeclared variable references. For each variable name that couldn't be resolved during compilation, records the variable name and list of methods that reference it. The loader creates Association objects (key -> nil) for each entry and populates the Undeclared dictionary, which is used by SystemDictionary>>at:put: to migrate variables when they become defined.",
            "items": {
                "type": "object",
                "required": ["key", "references"],
                "properties": {
                    "key": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name of the undeclared variable (e.g., 'Display', 'Processor', 'Transcript', 'Undeclared')"
                    },
                    "references": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "List of method identifiers that reference this variable. Format: 'ClassName>>selector' or 'class:ClassName>>selector'. Used for diagnostics and debugging."
                    }
                },
                "additionalProperties": false
            }
        },
        "poolDependencyGraph": {
            "type": "object",
            "description": "Canonical pool dependency metadata used for deterministic init ordering and validation.",
            "required": [
                "producers",
                "consumers",
                "edges",
                "executionOrder"
            ],
            "properties": {
                "producers": {
                    "type": "array",
                    "description": "Classes/methods that assign values into pool dictionaries (at:put:).",
                    "items": {
                        "type": "object",
                        "required": [
                            "classLocalId",
                            "poolLocalId",
                            "symbols"
                        ],
                        "properties": {
                            "classLocalId": {
                                "type": "string",
                                "description": "localId of producing class (usually metaclass for class>>initialize)"
                            },
                            "poolLocalId": {
                                "type": "string",
                                "description": "localId of the pool dictionary object (must exist in objects[])"
                            },
                            "symbols": {
                                "type": "array",
                                "description": "Indices into symbols[] for keys produced by this class/method in the pool.",
                                "items": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "methodLocalId": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Optional localId of the specific initialize method that produces these symbols"
                            },
                            "notes": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "consumers": {
                    "type": "array",
                    "description": "Classes/methods that reference pool variables (consume values).",
                    "items": {
                        "type": "object",
                        "required": [
                            "classLocalId",
                            "poolLocalId",
                            "symbols"
                        ],
                        "properties": {
                            "classLocalId": {
                                "type": "string",
                                "description": "localId of consuming class or metaclass"
                            },
                            "poolLocalId": {
                                "type": "string",
                                "description": "localId of the pool dictionary object"
                            },
                            "symbols": {
                                "type": "array",
                                "description": "Indices into symbols[] for keys referenced by this class/method.",
                                "items": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "methodLocalId": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Optional localId of the method that consumes these symbols"
                            },
                            "notes": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "edges": {
                    "type": "array",
                    "description": "Directed edges consumer → producer indicating init ordering constraints.",
                    "items": {
                        "type": "object",
                        "required": [
                            "from",
                            "to"
                        ],
                        "properties": {
                            "from": {
                                "type": "string",
                                "description": "Consumer classLocalId/metaclass localId"
                            },
                            "to": {
                                "type": "string",
                                "description": "Producer classLocalId/metaclass localId"
                            },
                            "symbols": {
                                "type": "array",
                                "description": "Optional subset of symbol indices that create this edge",
                                "items": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "notes": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "executionOrder": {
                    "type": "array",
                    "description": "Canonical topologically sorted list of class/metaclass localIds to initialize.",
                    "items": {
                        "type": "string"
                    }
                },
                "diagnostics": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "description": "Optional diagnostic report materializing validation results and reasons for edges.",
                    "properties": {
                        "messages": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "errors": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "notes": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "definitions": {
            "fieldValue": {
                "type": "object",
                "required": [
                    "type"
                ],
                "description": "Discriminated union for object field/indexed values",
                "oneOf": [
                    {
                        "properties": {
                            "type": {
                                "const": "nil"
                            }
                        },
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "true"
                            }
                        },
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "false"
                            }
                        },
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "smallInt"
                            },
                            "value": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "largePositiveInteger"
                            },
                            "value": {
                                "type": "string",
                                "pattern": "^[0-9]+$"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "largeNegativeInteger"
                            },
                            "value": {
                                "type": "string",
                                "pattern": "^-[0-9]+$"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "float"
                            },
                            "value": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "symbolRef"
                            },
                            "index": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "type",
                            "index"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "stringRef"
                            },
                            "index": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "type",
                            "index"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "objectRef"
                            },
                            "localId": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "required": [
                            "type",
                            "localId"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "character"
                            },
                            "codePoint": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 255
                            }
                        },
                        "required": [
                            "type",
                            "codePoint"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "bytes"
                            },
                            "encoding": {
                                "type": "string",
                                "enum": [
                                    "hex",
                                    "base64"
                                ]
                            },
                            "data": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "type",
                            "encoding",
                            "data"
                        ],
                        "additionalProperties": false
                    }
                ]
            },
            "literalValue": {
                "type": "object",
                "required": [
                    "type"
                ],
                "description": "Discriminated union for method literal frame entries",
                "oneOf": [
                    {
                        "properties": {
                            "type": {
                                "const": "symbol"
                            },
                            "index": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "type",
                            "index"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "string"
                            },
                            "index": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "type",
                            "index"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "smallInt"
                            },
                            "value": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "largePositiveInteger"
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "largeNegativeInteger"
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "float"
                            },
                            "value": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "association"
                            },
                            "association": {
                                "type": "object",
                                "required": [
                                    "keyType",
                                    "keyIndex",
                                    "valueRef"
                                ],
                                "properties": {
                                    "keyType": {
                                        "type": "string",
                                        "enum": [
                                            "symbol"
                                        ]
                                    },
                                    "keyIndex": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "valueRef": {
                                        "oneOf": [
                                            {
                                                "type": "null"
                                            },
                                            {
                                                "type": "object",
                                                "required": [
                                                    "type",
                                                    "localId"
                                                ],
                                                "properties": {
