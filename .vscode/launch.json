{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "generate-antlr",
      "program": "${workspaceFolder}/Smalltalk80/bin/Debug/net9.0/Smalltalk80.dll",
      "args": [
        "--filein",
        "Smalltalk-80 Source/Smalltalk-80.st"
      ],
      "cwd": "${workspaceFolder}/Smalltalk80",
      "stopAtEntry": false
    },
    {
      "name": "Smalltalk REPL",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "generate-antlr",
      "program": "${workspaceFolder}/Smalltalk80/bin/Debug/net9.0/Smalltalk80.dll",
      "args": [
        "--repl"
      ],
      "cwd": "${workspaceFolder}/Smalltalk80",
      "stopAtEntry": false
    }
  ]
}