{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/Smalltalk80.sln"],
            "type": "process",
            "problemMatcher": "$msCompile",
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "run",
            "command": "dotnet",
            "args": ["run", "--project", "${workspaceFolder}/Smalltalk80/Smalltalk80.csproj"],
            "type": "process",
            "group": {"kind": "test", "isDefault": true}
        }
    ]
}
