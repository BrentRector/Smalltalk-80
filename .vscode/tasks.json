{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "generate-antlr",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "\"& '${workspaceFolder}/scripts/GenerateIfNewer.ps1'\""
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "build",
            "dependsOn": [
                "build-and-test",
                "run-tests"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "run",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Smalltalk80/Smalltalk80.csproj"
            ],
            "type": "process",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "repl",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Smalltalk80/Smalltalk80.csproj",
                "--",
                "--repl"
            ],
            "type": "process",
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "run-tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/Run-ComprehensiveTests.ps1"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "build-and-test",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Smalltalk80.sln"
            ],
            "type": "process",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "generate-antlr"
            ]
        }
    ],
    "compounds": [
        {
            "label": "generate-build-run",
            "dependsOn": [
                "generate-antlr",
                "build",
                "run"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "generate-build-repl",
            "dependsOn": [
                "generate-antlr",
                "build",
                "repl"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "build-and-test-all",
            "dependsOn": [
                "build-and-test",
                "run-tests"
            ],
            "dependsOrder": "sequence"
        }
    ]
}