<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS8981</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)\$(AssemblyName).xml</DocumentationFile>
    <AssemblyName>Smalltalk80.FullInterpreter</AssemblyName>
    <RootNamespace>Smalltalk80.Interpreter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude old architecture files from compilation -->
    <Compile Remove="**\*.OLD.cs" />
  </ItemGroup>

  <!-- Auto-generate cold start JSON from Smalltalk-80.st when source changes -->
  <PropertyGroup>
    <SmalltalkSourceFile>$(MSBuildProjectDirectory)\..\Smalltalk-80 Source\Smalltalk-80.st</SmalltalkSourceFile>
    <ColdStartJsonOutput>$(MSBuildProjectDirectory)\Generated\coldstart.json</ColdStartJsonOutput>
  </PropertyGroup>

  <Target Name="GenerateColdStartJson"
          BeforeTargets="BeforeBuild"
          Inputs="$(SmalltalkSourceFile)"
          Outputs="$(ColdStartJsonOutput)"
          Condition="'$(SkipColdStartGeneration)' != 'true'">

    <Message Text="Smalltalk source is newer than coldstart.json - regenerating..." Importance="high" />

    <!-- Create Generated directory if it doesn't exist -->
    <MakeDir Directories="$(MSBuildProjectDirectory)\Generated" />

    <!-- Run compiler to generate JSON -->
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj&quot; --configuration Release -- &quot;$(SmalltalkSourceFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\Smalltalk-80 Source" />

    <!-- Copy generated JSON to Generated folder -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Smalltalk-80 Source\Smalltalk-80.json"
          DestinationFiles="$(ColdStartJsonOutput)"
          SkipUnchangedFiles="false" />

    <Message Text="Cold start JSON regenerated: $(ColdStartJsonOutput)" Importance="high" />
  </Target>

  <!-- Mark old generated C# as content (not compiled) for reference only -->
  <ItemGroup>
    <Compile Remove="Generated\*.cs" />
    <Content Include="Generated\*.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <!-- Ensure coldstart.json is copied to output directory -->
    <None Include="Generated\coldstart.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>