using Antlr4.Runtime;
using StandaloneCompiler.Generated;

namespace StandaloneCompiler.Tests;

/// <summary>
/// Tests for Smalltalk source code parsing.
/// </summary>
public sealed class ParserTests
{
    /// <summary>
    /// Creates a parser for the given Smalltalk source code.
    /// </summary>
    private static Smalltalk80Parser CreateParser(string source)
    {
        var inputStream = new AntlrInputStream(source);
        var lexer = new Smalltalk80Lexer(inputStream);
        var tokenStream = new CommonTokenStream(lexer);
        return new Smalltalk80Parser(tokenStream);
    }
    
    /// <summary>
    /// Tests parsing of simple unary methods.
    /// </summary>
    [Theory]
    [InlineData("isNil\n\t^true")]
    [InlineData("notNil\n\t^false")]
    [InlineData("yourself\n\t^self")]
    [InlineData("class\n\t<primitive: 111>")]
    public void ParseMethod_UnaryMethods_ParsesSuccessfully(string methodSource)
    {
        // Arrange
        var parser = CreateParser(methodSource);
        
        // Act
        var context = parser.methodEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var methodDef = context.methodDef();
        methodDef.Should().NotBeNull();
        methodDef.unarySelector().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of binary methods.
    /// </summary>
    [Theory]
    [InlineData("+ aNumber\n\t^self primitiveAdd: aNumber")]
    [InlineData("- aNumber\n\t^self primitiveSubtract: aNumber")]
    [InlineData("= anObject\n\t^self primitiveEqual: anObject")]
    [InlineData("< aNumber\n\t<primitive: 3>")]
    public void ParseMethod_BinaryMethods_ParsesSuccessfully(string methodSource)
    {
        // Arrange
        var parser = CreateParser(methodSource);
        
        // Act
        var context = parser.methodEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var methodDef = context.methodDef();
        methodDef.Should().NotBeNull();
        methodDef.binarySelector().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of keyword methods.
    /// </summary>
    [Theory]
    [InlineData("at: index\n\t^self primitiveAt: index")]
    [InlineData("at: index put: value\n\t^self primitiveAt: index put: value")]
    [InlineData("ifTrue: trueBlock ifFalse: falseBlock\n\t^trueBlock value")]
    [InlineData("to: stop do: aBlock\n\t| index |\n\tindex := self.\n\t[index <= stop] whileTrue: [aBlock value: index. index := index + 1]")]
    public void ParseMethod_KeywordMethods_ParsesSuccessfully(string methodSource)
    {
        // Arrange
        var parser = CreateParser(methodSource);
        
        // Act
        var context = parser.methodEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var methodDef = context.methodDef();
        methodDef.Should().NotBeNull();
        methodDef.keywordSelector().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of methods with temporaries.
    /// </summary>
    [Theory]
    [InlineData("test\n\t| temp |\n\ttemp := 1.\n\t^temp")]
    [InlineData("test\n\t| a b c |\n\ta := 1.\n\tb := 2.\n\tc := a + b.\n\t^c")]
    [InlineData("test\n\t| x y z |\n\tx := self.\n\ty := x class.\n\tz := y new.\n\t^z")]
    public void ParseMethod_WithTemporaries_ParsesSuccessfully(string methodSource)
    {
        // Arrange
        var parser = CreateParser(methodSource);
        
        // Act
        var context = parser.methodEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var methodDef = context.methodDef();
        methodDef.Should().NotBeNull();
        methodDef.methodBody()?.temporaries().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of blocks.
    /// </summary>
    [Theory]
    [InlineData("[1 + 2]")]
    [InlineData("[:x | x * 2]")]
    [InlineData("[:x :y | x + y]")]
    [InlineData("[| temp | temp := 1. temp + 1]")]
    public void ParseExpression_Blocks_ParsesSuccessfully(string blockSource)
    {
        // Arrange
        var parser = CreateParser(blockSource);
        
        // Act
        var context = parser.expressionEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var expression = context.expression();
        expression.Should().NotBeNull();
        expression.primary()?.block().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of cascaded messages.
    /// </summary>
    [Theory]
    [InlineData("Transcript show: 'Hello'; cr")]
    [InlineData("self at: 1 put: 'a'; at: 2 put: 'b'; yourself")]
    [InlineData("OrderedCollection new add: 1; add: 2; add: 3; yourself")]
    public void ParseExpression_Cascades_ParsesSuccessfully(string cascadeSource)
    {
        // Arrange
        var parser = CreateParser(cascadeSource);
        
        // Act
        var context = parser.expressionEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var expression = context.expression();
        expression.Should().NotBeNull();
        expression.cascadedMessage().Should().NotBeEmpty();
    }
    
    /// <summary>
    /// Tests parsing of literals.
    /// </summary>
    [Theory]
    [InlineData("42")]           // Integer
    [InlineData("3.14")]         // Float
    [InlineData("'hello'")]      // String
    [InlineData("#symbol")]      // Symbol
    [InlineData("$A")]           // Character
    [InlineData("#(1 2 3)")]     // Literal array
    [InlineData("#[1 2 3]")]     // Byte array
    public void ParseExpression_Literals_ParsesSuccessfully(string literalSource)
    {
        // Arrange
        var parser = CreateParser(literalSource);
        
        // Act
        var context = parser.expressionEntry();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var expression = context.expression();
        expression.Should().NotBeNull();
        expression.primary()?.literal().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests parsing of class definitions.
    /// </summary>
    [Fact]
    public void ParseClass_SimpleClass_ParsesSuccessfully()
    {
        // Arrange
        const string classSource = @"
Object subclass: #Point
    instanceVariableNames: 'x y'
    classVariableNames: ''
    poolDictionaries: ''
    category: 'Kernel-BasicObjects'!";
        
        var parser = CreateParser(classSource);
        
        // Act
        var context = parser.fileIn();
        
        // Assert
        context.Should().NotBeNull();
        context.exception.Should().BeNull();
        
        var entries = context.fileInEntry();
        entries.Should().NotBeEmpty();
        entries[0].classEntry().Should().NotBeNull();
    }
    
    /// <summary>
    /// Tests that invalid syntax produces parse errors.
    /// </summary>
    [Theory]
    [InlineData("test\n\t| temp\n\ttemp := 1")]         // Unclosed temporaries
    [InlineData("test\n\t^1 ^2")]                       // Multiple returns
    [InlineData("test\n\t1 +")]                         // Incomplete binary message
    [InlineData("test\n\t[")]                           // Unclosed block
    public void ParseMethod_InvalidSyntax_ProducesError(string invalidSource)
    {
        // Arrange
        var parser = CreateParser(invalidSource);
        
        // Act
        var context = parser.methodEntry();
        
        // Assert
        context.Should().NotBeNull();
        // Either an exception should be present or the parse tree should be incomplete
        (context.exception != null || context.methodDef() == null || 
         context.methodDef().methodBody() == null).Should().BeTrue();
    }
}