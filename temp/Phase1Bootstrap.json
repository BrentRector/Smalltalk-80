{
  "phase": "1",
  "description": "Create minimal class lattice using VM primitives",
  "steps": [
    {
      "comment": "=== Create Metaclass (self-referential) ===",
      "action": "primitiveNewClass",
      "result": "metaclassId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "metaclassId",
      "slot": 0,
      "value": "metaclassId",
      "comment": "Metaclass's class is itself"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "metaclassId",
      "name": "name",
      "value": {"intern": "Metaclass"}
    },
    {
      "comment": "=== Create Class ===",
      "action": "primitiveNewClass",
      "result": "classId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "classId",
      "slot": 0,
      "value": "metaclassId",
      "comment": "Class's class is Metaclass"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "classId",
      "name": "superclass",
      "value": "behaviorId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "classId",
      "name": "name",
      "value": {"intern": "Class"}
    },
    {
      "comment": "=== Create Behavior ===",
      "action": "primitiveNewClass",
      "result": "behaviorId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "behaviorId",
      "slot": 0,
      "value": "classId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "behaviorId",
      "name": "superclass",
      "value": "objectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "behaviorId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "behaviorId",
      "name": "instanceVariables",
      "value": {"primitive": "newArray", "size": 0}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "behaviorId",
      "name": "name",
      "value": {"intern": "Behavior"}
    },
    {
      "comment": "=== Create ProtoObject (root class) ===",
      "action": "primitiveNewClass",
      "result": "protoObjectId"
    },
    {
      "action": "primitiveNewMetaclass",
      "result": "protoObjectMetaclassId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "protoObjectId",
      "slot": 0,
      "value": "protoObjectMetaclassId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "protoObjectMetaclassId",
      "slot": 0,
      "value": "metaclassId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "protoObjectId",
      "name": "superclass",
      "value": null,
      "comment": "ProtoObject has no superclass"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "protoObjectId",
      "name": "name",
      "value": {"intern": "ProtoObject"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "protoObjectId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "comment": "=== Create Object ===",
      "action": "primitiveNewClass",
      "result": "objectId"
    },
    {
      "action": "primitiveNewMetaclass",
      "result": "objectMetaclassId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "objectId",
      "slot": 0,
      "value": "objectMetaclassId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "objectMetaclassId",
      "slot": 0,
      "value": "metaclassId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "objectId",
      "name": "superclass",
      "value": "protoObjectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "objectId",
      "name": "name",
      "value": {"intern": "Object"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "objectId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "comment": "=== Fix metaclass superclasses ===",
      "action": "primitiveSetNamedSlot",
      "target": "protoObjectMetaclassId",
      "name": "superclass",
      "value": "classId",
      "comment": "ProtoObject class → Class"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "objectMetaclassId",
      "name": "superclass",
      "value": "protoObjectMetaclassId",
      "comment": "Object class → ProtoObject class"
    },
    {
      "comment": "=== Create Symbol ===",
      "action": "primitiveNewClass",
      "result": "symbolId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "symbolId",
      "slot": 0,
      "value": {"primitive": "metaclassFor", "class": "symbolId"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "symbolId",
      "name": "superclass",
      "value": "objectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "symbolId",
      "name": "name",
      "value": {"intern": "Symbol"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "symbolId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "comment": "=== Create Dictionary ===",
      "action": "primitiveNewClass",
      "result": "dictionaryId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "dictionaryId",
      "slot": 0,
      "value": {"primitive": "metaclassFor", "class": "dictionaryId"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "dictionaryId",
      "name": "superclass",
      "value": "objectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "dictionaryId",
      "name": "name",
      "value": {"intern": "Dictionary"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "dictionaryId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "dictionaryId",
      "name": "instanceVariables",
      "value": {"array": ["keys", "values"]}
    },
    {
      "comment": "=== Create Array ===",
      "action": "primitiveNewClass",
      "result": "arrayId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "arrayId",
      "slot": 0,
      "value": {"primitive": "metaclassFor", "class": "arrayId"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "arrayId",
      "name": "superclass",
      "value": "objectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "arrayId",
      "name": "name",
      "value": {"intern": "Array"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "arrayId",
      "name": "methodDict",
      "value": {"primitive": "newDictionary"}
    },
    {
      "comment": "=== Create CompiledMethod ===",
      "action": "primitiveNewClass",
      "result": "compiledMethodId"
    },
    {
      "action": "primitiveSetSlot",
      "target": "compiledMethodId",
      "slot": 0,
      "value": {"primitive": "metaclassFor", "class": "compiledMethodId"}
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "compiledMethodId",
      "name": "superclass",
      "value": "objectId"
    },
    {
      "action": "primitiveSetNamedSlot",
      "target": "compiledMethodId",
      "name": "name",
      "value": {"intern": "CompiledMethod"}
    },
    {
      "comment": "=== Install critical primitive methods ===",
      "action": "primitiveInstallMethod",
      "class": "protoObjectId",
      "selector": "doesNotUnderstand:",
      "source": "doesNotUnderstand: aMessage\n    <primitive: 999>\n    self error: 'Message not understood'"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "objectId",
      "selector": "class",
      "source": "class\n    <primitive: 111>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "objectId",
      "selector": "==",
      "source": "== anObject\n    <primitive: 110>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "objectId",
      "selector": "perform:",
      "source": "perform: aSymbol\n    <primitive: 83>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "objectId",
      "selector": "perform:with:",
      "source": "perform: aSymbol with: anObject\n    <primitive: 84>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "behaviorId",
      "selector": "new",
      "source": "new\n    <primitive: 70>\n    ^self basicNew initialize"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "behaviorId",
      "selector": "basicNew",
      "source": "basicNew\n    <primitive: 70>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "behaviorId",
      "selector": "basicNew:",
      "source": "basicNew: size\n    <primitive: 71>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "arrayId",
      "selector": "at:",
      "source": "at: index\n    <primitive: 60>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "arrayId",
      "selector": "at:put:",
      "source": "at: index put: value\n    <primitive: 61>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "arrayId",
      "selector": "size",
      "source": "size\n    <primitive: 62>\n    ^self primitiveFailed"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "dictionaryId",
      "selector": "at:",
      "source": "at: key\n    | index |\n    index := keys indexOf: key.\n    index = 0 ifTrue: [^nil].\n    ^values at: index"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "dictionaryId",
      "selector": "at:put:",
      "source": "at: key put: value\n    | index |\n    index := keys indexOf: key.\n    index = 0\n        ifTrue: [\n            keys := keys copyWith: key.\n            values := values copyWith: value]\n        ifFalse: [\n            values at: index put: value].\n    ^value"
    },
    {
      "action": "primitiveInstallMethod",
      "class": "symbolId",
      "selector": "=",
      "source": "= aSymbol\n    <primitive: 110>\n    ^self primitiveFailed"
    },
    {
      "comment": "=== Register global objects ===",
      "action": "primitiveRegisterGlobal",
      "name": "nil",
      "value": null
    },
    {
      "action": "primitiveRegisterGlobal",
      "name": "true",
      "value": {"primitive": "newInstance", "class": "True"}
    },
    {
      "action": "primitiveRegisterGlobal",
      "name": "false",
      "value": {"primitive": "newInstance", "class": "False"}
    },
    {
      "action": "primitiveRegisterGlobal",
      "name": "Smalltalk",
      "value": {"primitive": "newSystemDictionary"}
    }
  ],
  "validation": {
    "checkpoints": [
      {
        "description": "Metaclass is self-referential",
        "test": "metaclassId.class == metaclassId"
      },
      {
        "description": "ProtoObject has no superclass",
        "test": "protoObjectId.superclass == nil"
      },
      {
        "description": "Object's superclass is ProtoObject",
        "test": "objectId.superclass == protoObjectId"
      },
      {
        "description": "Method lookup works",
        "test": "objectId.lookup('class') != nil"
      },
      {
        "description": "perform: primitive installed",
        "test": "objectId.lookup('perform:') != nil"
      }
    ]
  }
}