    {
      "op": "subclass",
      "superclass": "SequenceableCollection",
      "name": "OrderedCollection",
      "instanceVariables": ["array", "firstIndex", "lastIndex"],
      "classVariables": [],
      "category": "Collections-Sequenceable"
    },
    {
      "op": "compileMethod",
      "class": "OrderedCollection",
      "selector": "initialize",
      "source": "array := Array new: 10. firstIndex := 5. lastIndex := 4"
    },
    {
      "op": "compileMethod",
      "class": "OrderedCollection",
      "selector": "size",
      "source": "^lastIndex - firstIndex + 1"
    },
    {
      "op": "compileMethod",
      "class": "OrderedCollection",
      "selector": "at:",
      "source": "(index < 1 or: [index > self size]) ifTrue: [self error: 'Index out of bounds']. ^array at: firstIndex + index - 1"
    },
    {
      "op": "compileMethod",
      "class": "OrderedCollection",
      "selector": "add:",
      "source": "lastIndex := lastIndex + 1. lastIndex > array size ifTrue: [self grow]. array at: lastIndex put: anObject. ^anObject"
    },
    {
      "op": "compileMethod",
      "class": "OrderedCollection",
      "selector": "grow",
      "source": "| newArray newFirst | newArray := Array new: array size * 2. newFirst := newArray size // 3. 1 to: self size do: [:i | newArray at: newFirst + i - 1 put: (array at: firstIndex + i - 1)]. array := newArray. lastIndex := newFirst + self size - 1. firstIndex := newFirst"
    },
    {
      "op": "compileClassMethod",
      "class": "OrderedCollection",
      "selector": "new",
      "source": "^super new initialize"
    },

