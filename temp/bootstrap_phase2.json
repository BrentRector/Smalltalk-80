    {
      "comment": "=== Initialize SystemDictionary ===",
      "op": "compileClassMethod",
      "class": "SystemDictionary",
      "selector": "initialize",
      "source": "| smalltalk | smalltalk := self new. smalltalk at: #ProtoObject put: ProtoObject. smalltalk at: #Object put: Object. smalltalk at: #Behavior put: Behavior. smalltalk at: #ClassDescription put: ClassDescription. smalltalk at: #Class put: Class. smalltalk at: #Metaclass put: Metaclass. smalltalk at: #UndefinedObject put: UndefinedObject. smalltalk at: #Boolean put: Boolean. smalltalk at: #True put: True. smalltalk at: #False put: False. smalltalk at: #Symbol put: Symbol. smalltalk at: #Array put: Array. smalltalk at: #Dictionary put: Dictionary. smalltalk at: #SystemDictionary put: SystemDictionary. smalltalk at: #CompiledMethod put: CompiledMethod. smalltalk at: #SmallInteger put: SmallInteger. smalltalk at: #Message put: Message. smalltalk at: #BlockContext put: BlockContext. smalltalk at: #Collection put: Collection. smalltalk at: #SequenceableCollection put: SequenceableCollection. smalltalk at: #OrderedCollection put: OrderedCollection. smalltalk at: #String put: String. smalltalk at: #Magnitude put: Magnitude. smalltalk at: #Number put: Number. smalltalk at: #Compiler put: Compiler. smalltalk at: #Parser put: Parser. smalltalk at: #Scanner put: Scanner. smalltalk at: #Smalltalk put: smalltalk. smalltalk at: #nil put: nil. smalltalk at: #true put: true. smalltalk at: #false put: false. Smalltalk := smalltalk. ^smalltalk"
    },
