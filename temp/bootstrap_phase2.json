  "validation": {
    "checkpoints": [
      {
        "description": "Boolean control structures work",
        "test": "true ifTrue: [42] == 42"
      },
      {
        "description": "Blocks can be evaluated",
        "test": "[1 + 1] value == 2"
      },
      {
        "description": "Collections operational",
        "test": "OrderedCollection new add: 1; size == 1"
      },
      {
        "description": "String concatenation works",
        "test": "'hello' , ' world' == 'hello world'"
      },
      {
        "description": "SmallInteger arithmetic works",
        "test": "3 + 4 == 7"
      },
      {
        "description": "Compiler exists",
        "test": "Compiler respondsTo: #compile:"
      },
      {
        "description": "Smalltalk dictionary populated",
        "test": "Smalltalk at: #Object == Object"
      }
    ]
  }
