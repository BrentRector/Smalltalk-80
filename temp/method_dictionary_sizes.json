{
  "description": "Method dictionary size specifications for Phase 1/2 classes",
  "comment": "Sizes include current methods + expected system image methods + 50% growth buffer",
  "version": "1.0",
  "classes": {
    "Object": {
      "instanceMethodDictSize": 80,
      "classMethodDictSize": 25,
      "notes": "Core class with many inherited methods"
    },
    "Behavior": {
      "instanceMethodDictSize": 140,
      "classMethodDictSize": 20,
      "notes": "Many method management and introspection methods"
    },
    "Class": {
      "instanceMethodDictSize": 90,
      "classMethodDictSize": 25,
      "notes": "Class creation and management methods"
    },
    "Metaclass": {
      "instanceMethodDictSize": 30,
      "classMethodDictSize": 10,
      "notes": "Smaller specialized class"
    },
    "CompiledMethod": {
      "instanceMethodDictSize": 70,
      "classMethodDictSize": 15,
      "notes": "Method introspection and manipulation"
    },
    "MethodDictionary": {
      "instanceMethodDictSize": 20,
      "classMethodDictSize": 8,
      "notes": "Dictionary specialized for methods"
    },
    "Symbol": {
      "instanceMethodDictSize": 50,
      "classMethodDictSize": 15,
      "notes": "String-like behavior with identity semantics"
    },
    "String": {
      "instanceMethodDictSize": 110,
      "classMethodDictSize": 20,
      "notes": "Many string manipulation methods"
    },
    "Array": {
      "instanceMethodDictSize": 60,
      "classMethodDictSize": 15,
      "notes": "Collection methods plus array-specific operations"
    },
    "ByteArray": {
      "instanceMethodDictSize": 45,
      "classMethodDictSize": 10,
      "notes": "Array specialization with byte operations"
    },
    "Collection": {
      "instanceMethodDictSize": 75,
      "classMethodDictSize": 15,
      "notes": "Abstract collection protocol"
    },
    "Dictionary": {
      "instanceMethodDictSize": 65,
      "classMethodDictSize": 10,
      "notes": "Key-value collection with many operations"
    },
    "SystemDictionary": {
      "instanceMethodDictSize": 45,
      "classMethodDictSize": 8,
      "notes": "Global namespace management"
    }
  },
  "defaultSizes": {
    "instanceMethodDictSize": 32,
    "classMethodDictSize": 8,
    "notes": "Default sizes for classes not explicitly specified"
  }
}