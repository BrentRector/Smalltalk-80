<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>StandaloneCompiler</AssemblyName>
    <!-- Suppress CS3021 warnings from ANTLR-generated files -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>
  
  <!-- Grammar file included for reference, but we use pre-generated parser files -->
  <ItemGroup>
    <None Include="Smalltalk80.g4" />
  </ItemGroup>
  
  <!-- Exclude Generated folder from default compilation (we'll include it dynamically) -->
  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>
  
  <!-- Ensure Generated folder exists and regenerate parser if needed -->
  <Target Name="EnsureGeneratedFiles" BeforeTargets="CoreCompile">
    <!-- Create Generated folder if it doesn't exist -->
    <MakeDir Directories="$(MSBuildProjectDirectory)\Generated" Condition="!Exists('$(MSBuildProjectDirectory)\Generated')" />
    
    <!-- Run parser generation -->
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateIfNewer.ps1&quot;" 
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <!-- Dynamically include generated files for compilation -->
    <ItemGroup>
      <Compile Include="Generated\*.cs" />
    </ItemGroup>
  </Target>
  
  <!-- Clean target to remove generated files -->
  <Target Name="CleanGenerated" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)\Generated\*.*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\Generated" ContinueOnError="true" />
  </Target>
</Project>