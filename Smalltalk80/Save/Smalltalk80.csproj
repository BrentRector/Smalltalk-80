<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
  <!-- Need to specify the PrepareForCompile before target so that ANTLR4 finishes generating the
  parser before we try to compile it. -->
  <Target Name="RunAntlrIfNewer" BeforeTargets="CoreCompile">
    <Message Text="Calling script to build ANTLR4 parser..." Importance="high" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\scripts"
      Command="pwsh -ExecutionPolicy Bypass -File GenerateIfNewer.ps1" />
  </Target>

  <Target Name="CleanGeneratedFiles" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)\Generated\**\*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" />
  </Target>

</Project>