<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
  <!-- Need to specify the PrepareForCompile before target so that ANTLR4 finishes generating the
  parser before we try to compile it. -->
  <Target Name="RunAntlrIfNewer" BeforeTargets="CoreCompile">
    <Message Text="Calling script to build ANTLR4 parser..." Importance="high" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\scripts"
      Command="pwsh -ExecutionPolicy Bypass -File GenerateIfNewer.ps1" />
  </Target>

  <Target Name="CleanGeneratedFiles" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)\Generated\**\*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" />
  </Target>

  <!-- Copy essential bootstrap JSON files to output directory -->
  <Target Name="CopyBootstrapFiles" AfterTargets="Build">
    <Message Text="Copying bootstrap files to output directory..." Importance="high" />
    <ItemGroup>
      <EssentialBootstrapFiles Include="$(MSBuildProjectDirectory)\..\Bootstrap\bootstrap-schema.json" />
      <EssentialBootstrapFiles Include="$(MSBuildProjectDirectory)\..\Bootstrap\bootstrap.json" />
      <!-- Extended library files use pattern like test_counter.json -->
      <ExtendedLibraryFiles Include="$(MSBuildProjectDirectory)\..\Bootstrap\test_*.json" />
      <!-- Legacy numbered class files if any remain -->
      <LegacyClassFiles Include="$(MSBuildProjectDirectory)\..\Bootstrap\[0-9][0-9][0-9]_*.json" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)Bootstrap" />
    <Copy SourceFiles="@(EssentialBootstrapFiles)" DestinationFolder="$(OutputPath)Bootstrap" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExtendedLibraryFiles)" DestinationFolder="$(OutputPath)Bootstrap" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LegacyClassFiles)" DestinationFolder="$(OutputPath)Bootstrap" SkipUnchangedFiles="true" />
    <Message Text="Copied bootstrap files to $(OutputPath)Bootstrap" Importance="high" />
  </Target>

</Project>