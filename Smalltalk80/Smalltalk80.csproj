<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <AntlrGrammar>$(MSBuildProjectDirectory)/Grammar/Smalltalk80.g4</AntlrGrammar>
    <AntlrOutputDir>$(MSBuildProjectDirectory)/Generated</AntlrOutputDir>
    <AntlrJar>$(MSBuildProjectDirectory)/ANTLR4/antlr-4.13.2-complete.jar</AntlrJar>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <Target Name="GenerateAntlr" Inputs="$(AntlrGrammar)" Outputs="Generated/Smalltalk80Parser.cs" BeforeTargets="BeforeCompile">
    <Message Importance="high" Text="Running ANTLR on $(AntlrGrammar)" />
    <Exec Command="java -jar &quot;ANTLR4\antlr-4.13.2-complete.jar&quot; -Dlanguage=CSharp -no-listener -visitor -package Smalltalk80.Generated -o &quot;Generated&quot; &quot;Grammar\Smalltalk80.g4&quot;" />
  </Target></Project>