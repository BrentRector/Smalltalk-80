{
  "$schema": "./bootstrap-schema.json",
  "version": "2.0",
  "phase": "2",
  "description": "Phase 2: Collection classes - all created via message sends from Phase 1",
  "requires": ["bootstrap_phase1_complete.json"],
  "comments": [
    "Phase 2 adds collection infrastructure using only message sends.",
    "All classes are created by sending messages to Class.",
    "This demonstrates the self-sufficiency of Phase 1."
  ],
  "operations": [
    { "comment": "=== COLLECTION CLASSES ===" },
    
    { "comment": "Create Collection class hierarchy" },
    { "op": "sendMessage",
      "receiver": "Object",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["Collection", "", "", "", "Collections-Abstract"],
      "result": "Collection"
    },
    
    { "op": "sendMessage",
      "receiver": "Collection",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["SequenceableCollection", "", "", "", "Collections-Abstract"],
      "result": "SequenceableCollection"
    },
    
    { "op": "sendMessage",
      "receiver": "SequenceableCollection",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["OrderedCollection", "firstIndex lastIndex", "", "", "Collections-Sequenceable"],
      "result": "OrderedCollection"
    },
    
    { "op": "sendMessage",
      "receiver": "Collection",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["Set", "tally array", "", "", "Collections-Unordered"],
      "result": "Set"
    },
    
    { "op": "sendMessage",
      "receiver": "Set",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["Dictionary", "", "", "", "Collections-Unordered"],
      "result": "Dictionary"
    },
    
    { "op": "sendMessage",
      "receiver": "Set",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["IdentitySet", "", "", "", "Collections-Unordered"],
      "result": "IdentitySet"
    },
    
    { "op": "sendMessage",
      "receiver": "Dictionary",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["IdentityDictionary", "", "", "", "Collections-Unordered"],
      "result": "IdentityDictionary"
    },
    
    { "op": "sendMessage",
      "receiver": "Dictionary",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["SystemDictionary", "", "", "", "Collections-System"],
      "result": "SystemDictionary"
    },
    
    { "comment": "=== STREAM CLASSES ===" },
    
    { "op": "sendMessage",
      "receiver": "Object",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["Stream", "", "", "", "Collections-Streams"],
      "result": "Stream"
    },
    
    { "op": "sendMessage",
      "receiver": "Stream",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["PositionableStream", "collection position readLimit", "", "", "Collections-Streams"],
      "result": "PositionableStream"
    },
    
    { "op": "sendMessage",
      "receiver": "PositionableStream",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["ReadStream", "", "", "", "Collections-Streams"],
      "result": "ReadStream"
    },
    
    { "op": "sendMessage",
      "receiver": "PositionableStream",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["WriteStream", "writeLimit", "", "", "Collections-Streams"],
      "result": "WriteStream"
    },
    
    { "op": "sendMessage",
      "receiver": "WriteStream",
      "selector": "subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:",
      "args": ["ReadWriteStream", "", "", "", "Collections-Streams"],
      "result": "ReadWriteStream"
    },
    
    { "comment": "=== INSTALL BASIC COLLECTION METHODS ===" },
    
    { "op": "sendMessage",
      "receiver": "Collection",
      "selector": "compile:classified:",
      "args": ["size\n\t\"Answer the number of elements in the receiver.\"\n\t| count |\n\tcount := 0.\n\tself do: [:each | count := count + 1].\n\t^count", "accessing"]
    },
    
    { "op": "sendMessage",
      "receiver": "Collection",
      "selector": "compile:classified:",
      "args": ["isEmpty\n\t\"Answer whether the receiver contains any elements.\"\n\t^self size = 0", "testing"]
    },
    
    { "op": "sendMessage",
      "receiver": "Collection",
      "selector": "compile:classified:",
      "args": ["notEmpty\n\t\"Answer whether the receiver contains any elements.\"\n\t^self isEmpty not", "testing"]
    },
    
    { "op": "sendMessage",
      "receiver": "Dictionary",
      "selector": "compile:classified:",
      "args": ["at: key\n\t\"Answer the value associated with the key.\"\n\t^self at: key ifAbsent: [self errorKeyNotFound]", "accessing"]
    },
    
    { "op": "sendMessage",
      "receiver": "Dictionary",
      "selector": "compile:classified:",
      "args": ["at: key put: anObject\n\t\"Set the value at key to be anObject. Answer anObject.\"\n\t<primitive: 461>\n\t^self primitiveFailed", "accessing"]
    },
    
    { "comment": "=== REGISTER COLLECTION CLASSES AS GLOBALS ===" },
    
    { "op": "registerGlobal", "name": "Collection", "value": "Collection" },
    { "op": "registerGlobal", "name": "SequenceableCollection", "value": "SequenceableCollection" },
    { "op": "registerGlobal", "name": "OrderedCollection", "value": "OrderedCollection" },
    { "op": "registerGlobal", "name": "Set", "value": "Set" },
    { "op": "registerGlobal", "name": "Dictionary", "value": "Dictionary" },
    { "op": "registerGlobal", "name": "IdentitySet", "value": "IdentitySet" },
    { "op": "registerGlobal", "name": "IdentityDictionary", "value": "IdentityDictionary" },
    { "op": "registerGlobal", "name": "SystemDictionary", "value": "SystemDictionary" },
    { "op": "registerGlobal", "name": "Stream", "value": "Stream" },
    { "op": "registerGlobal", "name": "PositionableStream", "value": "PositionableStream" },
    { "op": "registerGlobal", "name": "ReadStream", "value": "ReadStream" },
    { "op": "registerGlobal", "name": "WriteStream", "value": "WriteStream" },
    { "op": "registerGlobal", "name": "ReadWriteStream", "value": "ReadWriteStream" }
  ]
}