{
  "$schema": "./bootstrap-schema.json",
  "version": "2.0",
  "phase": "test",
  "description": "Test that theoretical minimum (10 classes) enables class creation",
  "requires": ["bootstrap_phase1_theoretical_minimum.json"],
  "operations": [
    { "comment": "=== TEST: Create Point class with theoretical minimum ===" },
    
    { "comment": "Step 1: Create Point metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "PointClass" },
    { "op": "sendMessage", "receiver": "PointClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "PointClassMethods" },
    { "op": "sendMessage", "receiver": "PointClass", "selector": "methodDictionary:", "args": ["PointClassMethods"] },
    { "op": "sendMessage", "receiver": "PointClass", "selector": "format:", "args": [2] },
    
    { "comment": "Step 2: Create Point class" },
    { "op": "sendMessage", "receiver": "PointClass", "selector": "new", "result": "Point" },
    { "op": "sendMessage", "receiver": "Point", "selector": "superclass:", "args": ["Object"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "PointMethods" },
    { "op": "sendMessage", "receiver": "Point", "selector": "methodDictionary:", "args": ["PointMethods"] },
    { "op": "sendMessage", "receiver": "Point", "selector": "format:", "args": [2] },
    
    { "comment": "Step 3: Set name" },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["Point"], "result": "PointSymbol" },
    { "op": "sendMessage", "receiver": "Point", "selector": "name:", "args": ["PointSymbol"] },
    
    { "comment": "Step 4: Link metaclass and class" },
    { "op": "sendMessage", "receiver": "PointClass", "selector": "thisClass:", "args": ["Point"] },
    
    { "comment": "Step 5: Create a method" },
    { "op": "sendMessage", "receiver": "CompiledMethod", "selector": "new", "result": "printMethod" },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["printString"], "result": "printSelector" },
    { "op": "sendMessage", "receiver": "printMethod", "selector": "selector:", "args": ["printSelector"] },
    { "op": "sendMessage", "receiver": "ByteArray", "selector": "new", "result": "printBytecodes" },
    { "op": "sendMessage", "receiver": "printMethod", "selector": "bytecodes:", "args": ["printBytecodes"] },
    { "op": "sendMessage", "receiver": "Array", "selector": "new", "result": "printLiterals" },
    { "op": "sendMessage", "receiver": "printMethod", "selector": "literals:", "args": ["printLiterals"] },
    
    { "comment": "Step 6: Install method" },
    { "op": "sendMessage", "receiver": "PointMethods", "selector": "at:put:", "args": ["printSelector", "printMethod"] },
    
    { "comment": "Step 7: Test - Create Point instance" },
    { "op": "sendMessage", "receiver": "Point", "selector": "new", "result": "aPoint" },
    
    { "comment": "Verify success" },
    { "op": "assert", "target": "Point", "type": "Class" },
    { "op": "assert", "target": "aPoint", "type": "Point" },
    
    { "comment": "=== SUCCESS: Can create classes with only 10 core classes! ===" }
  ]
}