    { "comment": "Create True metaclass and class" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "TrueClass" },
    { "op": "sendMessage", "receiver": "TrueClass", "selector": "superclass:", "args": ["BooleanClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "TrueClassMethods" },
    { "op": "sendMessage", "receiver": "TrueClass", "selector": "methodDictionary:", "args": ["TrueClassMethods"] },
    { "op": "sendMessage", "receiver": "TrueClass", "selector": "format:", "args": [0] },
    
    { "op": "sendMessage", "receiver": "TrueClass", "selector": "new", "result": "True" },
    { "op": "sendMessage", "receiver": "True", "selector": "superclass:", "args": ["Boolean"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "TrueMethods" },
    { "op": "sendMessage", "receiver": "True", "selector": "methodDictionary:", "args": ["TrueMethods"] },
    { "op": "sendMessage", "receiver": "True", "selector": "format:", "args": [0] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["True"], "result": "TrueSymbol" },
    { "op": "sendMessage", "receiver": "True", "selector": "name:", "args": ["TrueSymbol"] },
    { "op": "sendMessage", "receiver": "TrueClass", "selector": "thisClass:", "args": ["True"] },
    
    { "comment": "Create true singleton" },
