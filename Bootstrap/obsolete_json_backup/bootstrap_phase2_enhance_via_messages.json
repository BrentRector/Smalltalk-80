    { "op": "registerGlobal", "name": "False", "value": "False" },
    { "op": "registerGlobal", "name": "true", "value": "true" },
    { "op": "registerGlobal", "name": "false", "value": "false" },
    
    { "comment": "=== CREATE Character ===" },
    
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "CharacterClass" },
    { "op": "sendMessage", "receiver": "CharacterClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "CharacterClassMethods" },
    { "op": "sendMessage", "receiver": "CharacterClass", "selector": "methodDictionary:", "args": ["CharacterClassMethods"] },
    { "op": "sendMessage", "receiver": "CharacterClass", "selector": "format:", "args": [0] },
    
    { "op": "sendMessage", "receiver": "CharacterClass", "selector": "new", "result": "Character" },
