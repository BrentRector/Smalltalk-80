    { "comment": "Create False metaclass and class" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "FalseClass" },
    { "op": "sendMessage", "receiver": "FalseClass", "selector": "superclass:", "args": ["BooleanClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "FalseClassMethods" },
    { "op": "sendMessage", "receiver": "FalseClass", "selector": "methodDictionary:", "args": ["FalseClassMethods"] },
    { "op": "sendMessage", "receiver": "FalseClass", "selector": "format:", "args": [0] },
    
    { "op": "sendMessage", "receiver": "FalseClass", "selector": "new", "result": "False" },
    { "op": "sendMessage", "receiver": "False", "selector": "superclass:", "args": ["Boolean"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "FalseMethods" },
    { "op": "sendMessage", "receiver": "False", "selector": "methodDictionary:", "args": ["FalseMethods"] },
    { "op": "sendMessage", "receiver": "False", "selector": "format:", "args": [0] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["False"], "result": "FalseSymbol" },
    { "op": "sendMessage", "receiver": "False", "selector": "name:", "args": ["FalseSymbol"] },
    { "op": "sendMessage", "receiver": "FalseClass", "selector": "thisClass:", "args": ["False"] },
    
    { "comment": "Create false singleton" },
