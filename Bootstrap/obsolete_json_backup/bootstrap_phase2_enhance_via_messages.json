{
  "$schema": "./bootstrap-schema.json",
  "version": "2.0",
  "phase": "2-enhance",
  "description": "Phase 2: Add missing fundamental classes via message sends",
  "requires": ["bootstrap_phase1_theoretical_minimum.json"],
  "comments": [
    "After theoretical minimum Phase 1, we add the 'missing' classes",
    "that make the system practical: ProtoObject, ClassDescription,",
    "UndefinedObject, SmallInteger, Association, etc.",
    "Everything is created via message sends - no direct manipulation."
  ],
  "operations": [
    { "comment": "=== ADD ProtoObject ABOVE Object ===" },
    
    { "comment": "Create ProtoObject metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "ProtoObjectClass" },
    { "op": "sendMessage", "receiver": "ProtoObjectClass", "selector": "superclass:", "args": ["Class"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "ProtoObjectClassMethods" },
    { "op": "sendMessage", "receiver": "ProtoObjectClass", "selector": "methodDictionary:", "args": ["ProtoObjectClassMethods"] },
    { "op": "sendMessage", "receiver": "ProtoObjectClass", "selector": "format:", "args": [0] },
    
    { "comment": "Create ProtoObject class" },
    { "op": "sendMessage", "receiver": "ProtoObjectClass", "selector": "new", "result": "ProtoObject" },
    { "op": "sendMessage", "receiver": "ProtoObject", "selector": "superclass:", "args": [null] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "ProtoObjectMethods" },
    { "op": "sendMessage", "receiver": "ProtoObject", "selector": "methodDictionary:", "args": ["ProtoObjectMethods"] },
    { "op": "sendMessage", "receiver": "ProtoObject", "selector": "format:", "args": [0] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["ProtoObject"], "result": "ProtoObjectSymbol" },
    { "op": "sendMessage", "receiver": "ProtoObject", "selector": "name:", "args": ["ProtoObjectSymbol"] },
    { "op": "sendMessage", "receiver": "ProtoObjectClass", "selector": "thisClass:", "args": ["ProtoObject"] },
    
    { "comment": "Now fix Object to be subclass of ProtoObject" },
    { "op": "sendMessage", "receiver": "Object", "selector": "superclass:", "args": ["ProtoObject"] },
    { "op": "sendMessage", "receiver": "ObjectClass", "selector": "superclass:", "args": ["ProtoObjectClass"] },
    
    { "op": "registerGlobal", "name": "ProtoObject", "value": "ProtoObject" },
    
    { "comment": "=== ADD ClassDescription BETWEEN Behavior AND Class ===" },
    
    { "comment": "Create ClassDescription metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "ClassDescriptionClass" },
    { "op": "sendMessage", "receiver": "ClassDescriptionClass", "selector": "superclass:", "args": ["BehaviorClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "ClassDescriptionClassMethods" },
    { "op": "sendMessage", "receiver": "ClassDescriptionClass", "selector": "methodDictionary:", "args": ["ClassDescriptionClassMethods"] },
    { "op": "sendMessage", "receiver": "ClassDescriptionClass", "selector": "format:", "args": [0] },
    
    { "comment": "Create ClassDescription class" },
    { "op": "sendMessage", "receiver": "ClassDescriptionClass", "selector": "new", "result": "ClassDescription" },
    { "op": "sendMessage", "receiver": "ClassDescription", "selector": "superclass:", "args": ["Behavior"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "ClassDescriptionMethods" },
    { "op": "sendMessage", "receiver": "ClassDescription", "selector": "methodDictionary:", "args": ["ClassDescriptionMethods"] },
    { "op": "sendMessage", "receiver": "ClassDescription", "selector": "format:", "args": [2] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["ClassDescription"], "result": "ClassDescriptionSymbol" },
    { "op": "sendMessage", "receiver": "ClassDescription", "selector": "name:", "args": ["ClassDescriptionSymbol"] },
    { "op": "sendMessage", "receiver": "ClassDescriptionClass", "selector": "thisClass:", "args": ["ClassDescription"] },
    
    { "comment": "Fix Class and Metaclass to be subclasses of ClassDescription" },
    { "op": "sendMessage", "receiver": "Class", "selector": "superclass:", "args": ["ClassDescription"] },
    { "op": "sendMessage", "receiver": "ClassClass", "selector": "superclass:", "args": ["ClassDescriptionClass"] },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "superclass:", "args": ["ClassDescription"] },
    { "op": "sendMessage", "receiver": "MetaclassClass", "selector": "superclass:", "args": ["ClassDescriptionClass"] },
    
    { "op": "registerGlobal", "name": "ClassDescription", "value": "ClassDescription" },
    
    { "comment": "=== CREATE UndefinedObject AND nil ===" },
    
    { "comment": "Create UndefinedObject metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "UndefinedObjectClass" },
    { "op": "sendMessage", "receiver": "UndefinedObjectClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "UndefinedObjectClassMethods" },
    { "op": "sendMessage", "receiver": "UndefinedObjectClass", "selector": "methodDictionary:", "args": ["UndefinedObjectClassMethods"] },
    { "op": "sendMessage", "receiver": "UndefinedObjectClass", "selector": "format:", "args": [0] },
    
    { "comment": "Create UndefinedObject class" },
    { "op": "sendMessage", "receiver": "UndefinedObjectClass", "selector": "new", "result": "UndefinedObject" },
    { "op": "sendMessage", "receiver": "UndefinedObject", "selector": "superclass:", "args": ["Object"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "UndefinedObjectMethods" },
    { "op": "sendMessage", "receiver": "UndefinedObject", "selector": "methodDictionary:", "args": ["UndefinedObjectMethods"] },
    { "op": "sendMessage", "receiver": "UndefinedObject", "selector": "format:", "args": [0] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["UndefinedObject"], "result": "UndefinedObjectSymbol" },
    { "op": "sendMessage", "receiver": "UndefinedObject", "selector": "name:", "args": ["UndefinedObjectSymbol"] },
    { "op": "sendMessage", "receiver": "UndefinedObjectClass", "selector": "thisClass:", "args": ["UndefinedObject"] },
    
    { "comment": "Create nil as the singleton instance" },
    { "op": "sendMessage", "receiver": "UndefinedObject", "selector": "new", "result": "nil" },
    
    { "op": "registerGlobal", "name": "UndefinedObject", "value": "UndefinedObject" },
    { "op": "registerGlobal", "name": "nil", "value": "nil" },
    
    { "comment": "=== CREATE SmallInteger ===" },
    
    { "comment": "Create SmallInteger metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "SmallIntegerClass" },
    { "op": "sendMessage", "receiver": "SmallIntegerClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "SmallIntegerClassMethods" },
    { "op": "sendMessage", "receiver": "SmallIntegerClass", "selector": "methodDictionary:", "args": ["SmallIntegerClassMethods"] },
    { "op": "sendMessage", "receiver": "SmallIntegerClass", "selector": "format:", "args": [0] },
    
    { "comment": "Create SmallInteger class" },
    { "op": "sendMessage", "receiver": "SmallIntegerClass", "selector": "new", "result": "SmallInteger" },
    { "op": "sendMessage", "receiver": "SmallInteger", "selector": "superclass:", "args": ["Object"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "SmallIntegerMethods" },
    { "op": "sendMessage", "receiver": "SmallInteger", "selector": "methodDictionary:", "args": ["SmallIntegerMethods"] },
    { "op": "sendMessage", "receiver": "SmallInteger", "selector": "format:", "args": [1] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["SmallInteger"], "result": "SmallIntegerSymbol" },
    { "op": "sendMessage", "receiver": "SmallInteger", "selector": "name:", "args": ["SmallIntegerSymbol"] },
    { "op": "sendMessage", "receiver": "SmallIntegerClass", "selector": "thisClass:", "args": ["SmallInteger"] },
    
    { "op": "registerGlobal", "name": "SmallInteger", "value": "SmallInteger" },
    
    { "comment": "=== CREATE Association FOR DICTIONARIES ===" },
    
    { "comment": "Create Association metaclass" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "AssociationClass" },
    { "op": "sendMessage", "receiver": "AssociationClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "AssociationClassMethods" },
    { "op": "sendMessage", "receiver": "AssociationClass", "selector": "methodDictionary:", "args": ["AssociationClassMethods"] },
    { "op": "sendMessage", "receiver": "AssociationClass", "selector": "format:", "args": [0] },
    
    { "comment": "Create Association class" },
    { "op": "sendMessage", "receiver": "AssociationClass", "selector": "new", "result": "Association" },
    { "op": "sendMessage", "receiver": "Association", "selector": "superclass:", "args": ["Object"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "AssociationMethods" },
    { "op": "sendMessage", "receiver": "Association", "selector": "methodDictionary:", "args": ["AssociationMethods"] },
    { "op": "sendMessage", "receiver": "Association", "selector": "format:", "args": [2] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["Association"], "result": "AssociationSymbol" },
    { "op": "sendMessage", "receiver": "Association", "selector": "name:", "args": ["AssociationSymbol"] },
    { "op": "sendMessage", "receiver": "AssociationClass", "selector": "thisClass:", "args": ["Association"] },
    
    { "op": "registerGlobal", "name": "Association", "value": "Association" },
    
    { "comment": "=== CREATE Boolean, True, False ===" },
    
    { "comment": "Create Boolean metaclass and class" },
    { "op": "sendMessage", "receiver": "Metaclass", "selector": "new", "result": "BooleanClass" },
    { "op": "sendMessage", "receiver": "BooleanClass", "selector": "superclass:", "args": ["ObjectClass"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "BooleanClassMethods" },
    { "op": "sendMessage", "receiver": "BooleanClass", "selector": "methodDictionary:", "args": ["BooleanClassMethods"] },
    { "op": "sendMessage", "receiver": "BooleanClass", "selector": "format:", "args": [0] },
    
    { "op": "sendMessage", "receiver": "BooleanClass", "selector": "new", "result": "Boolean" },
    { "op": "sendMessage", "receiver": "Boolean", "selector": "superclass:", "args": ["Object"] },
    { "op": "sendMessage", "receiver": "MethodDictionary", "selector": "new", "result": "BooleanMethods" },
    { "op": "sendMessage", "receiver": "Boolean", "selector": "methodDictionary:", "args": ["BooleanMethods"] },
    { "op": "sendMessage", "receiver": "Boolean", "selector": "format:", "args": [0] },
    { "op": "sendMessage", "receiver": "Symbol", "selector": "intern:", "args": ["Boolean"], "result": "BooleanSymbol" },
