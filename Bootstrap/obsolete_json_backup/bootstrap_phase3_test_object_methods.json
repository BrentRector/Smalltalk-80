{
  "phase": 3,
  "description": "Test Object fundamental methods",
  "actions": [
    {
      "action": "createObject",
      "class": "Object",
      "assign": "testObj"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "yourself",
      "arguments": [],
      "expectResult": "testObj",
      "description": "Test yourself returns self"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "isNil",
      "arguments": [],
      "expectResult": false,
      "description": "Test isNil returns false"
    },
    {
      "action": "send", 
      "receiver": "testObj",
      "selector": "notNil",
      "arguments": [],
      "expectResult": true,
      "description": "Test notNil returns true"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "isInteger",
      "arguments": [],
      "expectResult": false,
      "description": "Test isInteger returns false"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "==",
      "arguments": ["testObj"],
      "expectResult": true,
      "description": "Test identity comparison with self"
    },
    {
      "action": "createObject",
      "class": "Object",
      "assign": "testObj2"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "==",
      "arguments": ["testObj2"],
      "expectResult": false,
      "description": "Test identity comparison with different object"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "=",
      "arguments": ["testObj"],
      "expectResult": true,
      "description": "Test equality defaults to identity"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "class",
      "arguments": [],
      "expectClass": "Object",
      "description": "Test class returns Object"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "size",
      "arguments": [],
      "expectResult": 0,
      "description": "Test size returns 0 for non-indexable"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "basicSize",
      "arguments": [],
      "expectResult": 0,
      "description": "Test basicSize returns 0 for non-indexable"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "hash",
      "arguments": [],
      "assign": "hash1",
      "description": "Get hash value"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "hash",
      "arguments": [],
      "assign": "hash2",
      "description": "Get hash value again"
    },
    {
      "action": "compare",
      "left": "hash1",
      "right": "hash2",
      "operator": "=",
      "expectResult": true,
      "description": "Test hash is consistent"
    },
    {
      "action": "send",
      "receiver": "testObj",
      "selector": "error:",
      "arguments": ["test error"],
      "expectResult": "testObj",
      "description": "Test simplified error returns self"
    }
  ]
}