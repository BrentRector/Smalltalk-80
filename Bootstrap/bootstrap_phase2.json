  "validation": {
    "checkpoints": [
      {
        "description": "Core class hierarchy established",
        "test": "Class superclass == ClassDescription and: [ClassDescription superclass == Behavior]"
      },
      {
        "description": "ProtoObject methods installed",
        "test": "ProtoObject methodDict includesKey: #=="
      },
      {
        "description": "Object methods installed",
        "test": "(Object methodDict includesKey: #initialize) and: [(Object methodDict includesKey: #class)]"
      },
      {
        "description": "Boolean control flow works",
        "test": "(True methodDict includesKey: #ifTrue:) and: [(False methodDict includesKey: #ifFalse:)]"
      },
      {
        "description": "SmallInteger arithmetic works",
        "test": "(SmallInteger methodDict includesKey: #+) and: [(SmallInteger methodDict includesKey: #<)]"
      },
      {
        "description": "All classes registered in Smalltalk",
        "test": "(Smalltalk includesKey: #Object) and: [(Smalltalk includesKey: #Array)]"
      }
    ]
