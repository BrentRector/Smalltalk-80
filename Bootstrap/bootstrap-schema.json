{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Smalltalk Bootstrap Manifest",
  "type": "object",
  "required": ["version", "phase", "description"],
  "properties": {
    "version": { 
      "type": "string",
      "description": "Version of the bootstrap manifest format"
    },
    "phase": { 
      "type": "string",
      "description": "The bootstrap phase (1, 2, or 3)"
    },
    "description": { 
      "type": "string",
      "description": "Human-readable description of this bootstrap phase"
    },
    "comments": {
      "type": "array",
      "description": "Optional comments about the bootstrap phase",
      "items": { "type": "string" }
    },
    "messages": {
      "type": "array",
      "description": "List of messages to send (for phase 2)",
      "items": {
        "type": "object",
        "required": ["receiver", "selector"],
        "properties": {
          "receiver": {
            "type": "string",
            "description": "The receiver of the message"
          },
          "selector": {
            "type": "string",
            "description": "The message selector"
          },
          "arguments": {
            "type": "array",
            "description": "Arguments for the message",
            "items": {}
          },
          "resultName": {
            "type": "string",
            "description": "Variable name to store the result"
          },
          "comment": {
            "type": "string",
            "description": "Optional comment explaining the message"
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "description": "List of bootstrap operations to execute",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "description": "The operation type",
            "enum": [
              "createObject",
              "setSlot",
              "patchPointer",
              "setSuperclass",
              "setInstanceVariables",
              "setClassVariables",
              "defineClass",
              "defineMethod",
              "defineMetaclass",
              "setCategory"
            ]
          },
          "target": { 
            "type": "string",
            "description": "The target object for this operation"
          },
          "slot": { 
            "type": ["string", "integer"],
            "description": "The slot index or name to set"
          },
          "name": { 
            "type": "string",
            "description": "The name of the class, method, or variable"
          },
          "value": {
            "description": "The value to set (can be string reference, literal, or nested operation)"
          },
          "result": { 
            "type": "string",
            "description": "Variable name to store the operation result"
          },
          "superclass": { 
            "type": "string",
            "description": "The superclass for class definition"
          },
          "instanceVariables": {
            "type": "array",
            "description": "Instance variable names",
            "items": { "type": "string" }
          },
          "classVariables": {
            "type": "array",
            "description": "Class variable names",
            "items": { "type": "string" }
          },
          "poolDictionaries": {
            "type": "array",
            "description": "Pool dictionary names",
            "items": { "type": "string" }
          },
          "category": {
            "type": "string",
            "description": "The class category"
          },
          "selector": {
            "type": "string",
            "description": "Method selector"
          },
          "source": {
            "type": "string",
            "description": "Method source code"
          },
          "className": {
            "type": "string",
            "description": "The class name for method compilation"
          },
          "methodCategory": {
            "type": "string",
            "description": "The method category"
          },
          "arguments": {
            "type": "array",
            "description": "Arguments for message send",
            "items": {}
          },
          "comment": {
            "type": "string",
            "description": "Optional comment explaining the operation"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "description": "Optional validation checks for this phase",
      "properties": {
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "test": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}