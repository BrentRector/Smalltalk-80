      "comment": "Install class creation methods",
      "target": "Behavior",
      "slot": "methodDict",
      "value": "methodDict_Behavior_Phase3"
    },
    {
      "target": "ClassClass",
      "slot": "methodDict",
      "value": "methodDict_ClassClass_Phase3"
    },
    {
      "target": "CompiledMethod",
      "slot": "methodDict",
      "value": "methodDict_CompiledMethod_Phase3"
    },
