  "validation": {
    "checkpoints": [
      {
        "description": "Behavior has subclass:instanceVariableNames:... method",
        "test": "Behavior.methodDict.includes(#subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:)"
      },
      {
        "description": "Behavior has compile: method",
        "test": "Behavior.methodDict.includes(#compile:)"
      },
      {
        "description": "CompiledMethod has installInClass: method",
