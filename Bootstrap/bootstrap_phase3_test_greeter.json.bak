{
  "$schema": "./bootstrap-schema.json",
  "phase": "3",
  "description": "Test manifest for Greeter class - creates class, installs methods, and tests execution",
  "classes": [
    {
      "name": "Greeter",
      "superclass": "Object",
      "instanceVariables": ["name"],
      "classVariables": [],
      "poolDictionaries": [],
      "category": "Examples"
    }
  ],
  "methods": [
    {
      "class": "Greeter",
      "selector": "setName:",
      "source": "setName: aString\n\tname := aString.",
      "comment": "Store argument (temp 0) into instance variable 0 (name), return self",
      "note": "Using canonical Smalltalk-80 bytecodes",
      "bytecodes": [16, 96, 176],
      "literals": [],
      "numArgs": 1
    },
    {
      "class": "Greeter",
      "selector": "greet",
      "source": "greet\n\t^'Hello, ' , name.",
      "comment": "Push literal 'Hello, ', push instance var name, send #, selector, return",
      "bytecodes": [32, 0, 225, 180],
      "literals": ["Hello, ", ","],
      "numArgs": 0
    },
    {
      "class": "Greeter",
      "selector": "name",
      "source": "name\n\t^name",
      "comment": "Push instance variable 0 (name) and return it",
      "bytecodes": [0, 180],
      "literals": [],
      "numArgs": 0
    }
  ],
  "testSequence": [
    {
      "action": "createInstance",
      "class": "Greeter",
      "assignTo": "greeter"
    },
    {
      "action": "sendMessage",
      "receiver": "greeter",
      "selector": "setName:",
      "arguments": ["World"]
    },
    {
      "action": "sendMessage",
      "receiver": "greeter",
      "selector": "greet",
      "expectResult": "Hello, World"
    }
  ]
}