  "objects": [
    {
      "id": "Smalltalk",
      "class": "SystemDictionary",
      "size": 512,
      "comment": "The global system dictionary that holds all classes and globals - needs space for ~100+ entries"
    },
    {
      "id": "true",
      "class": "True",
      "comment": "The singleton instance of True"
    },
    {
      "id": "false",
      "class": "False",
      "comment": "The singleton instance of False"
    },
    {
      "id": "nil",
      "class": "UndefinedObject",
      "comment": "The singleton instance of UndefinedObject"
    }
  ],
  "patches": [
    {
      "comment": "Register Smalltalk as a global",
      "target": "Smalltalk",
      "operation": "registerGlobal",
      "name": "Smalltalk"
    },
    {
      "comment": "Register true as a global",
      "target": "true",
      "operation": "registerGlobal",
      "name": "true"
    },
    {
      "comment": "Register false as a global",
      "target": "false",
      "operation": "registerGlobal",
