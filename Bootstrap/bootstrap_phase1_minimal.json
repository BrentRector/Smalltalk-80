{
  "$schema": "./bootstrap-schema.json",
  "version": "2.0",
  "phase": "1-minimal",
  "description": "Absolute minimal Phase 1 that enables message-based class creation",
  "comments": [
    "This is the truly minimal set needed to switch to message-based bootstrap.",
    "After this phase, we can create any class using: Metaclass new, etc.",
    "Only 14 classes and ~30 methods are needed."
  ],
  "operations": [
    { "comment": "=== IRREDUCIBLE KERNEL - The class/metaclass lattice ===" },
    { "op": "createObject", "result": "ProtoObject" },
    { "op": "createObject", "result": "Object" },
    { "op": "createObject", "result": "Behavior" },
    { "op": "createObject", "result": "ClassDescription" },
    { "op": "createObject", "result": "Class" },
    { "op": "createObject", "result": "Metaclass" },
    { "op": "createObject", "result": "UndefinedObject" },
    { "op": "createObject", "result": "nil" },
    
    { "comment": "=== MINIMAL DATA TYPES FOR METHOD CREATION ===" },
    { "op": "createObject", "result": "SmallInteger" },
    { "op": "createObject", "result": "Symbol" },
    { "op": "createObject", "result": "Array" },
    { "op": "createObject", "result": "ByteArray" },
    
    { "comment": "=== METHOD INFRASTRUCTURE ===" },
    { "op": "createObject", "result": "CompiledMethod" },
    { "op": "createObject", "result": "MethodDictionary" },
    { "op": "createObject", "result": "Association" },
    
    { "comment": "=== CREATE METACLASSES ===" },
    { "op": "createObject", "result": "ProtoObjectClass" },
    { "op": "createObject", "result": "ObjectClass" },
    { "op": "createObject", "result": "BehaviorClass" },
    { "op": "createObject", "result": "ClassDescriptionClass" },
    { "op": "createObject", "result": "ClassClass" },
    { "op": "createObject", "result": "MetaclassClass" },
    { "op": "createObject", "result": "UndefinedObjectClass" },
    { "op": "createObject", "result": "SmallIntegerClass" },
    { "op": "createObject", "result": "SymbolClass" },
    { "op": "createObject", "result": "ArrayClass" },
    { "op": "createObject", "result": "ByteArrayClass" },
    { "op": "createObject", "result": "CompiledMethodClass" },
    { "op": "createObject", "result": "MethodDictionaryClass" },
    { "op": "createObject", "result": "AssociationClass" },

    { "comment": "=== SET CLASS POINTERS ===" },
    { "op": "patchPointer", "target": "ProtoObject", "slot": "class", "value": "ProtoObjectClass" },
    { "op": "patchPointer", "target": "Object", "slot": "class", "value": "ObjectClass" },
    { "op": "patchPointer", "target": "Behavior", "slot": "class", "value": "BehaviorClass" },
    { "op": "patchPointer", "target": "ClassDescription", "slot": "class", "value": "ClassDescriptionClass" },
    { "op": "patchPointer", "target": "Class", "slot": "class", "value": "ClassClass" },
    { "op": "patchPointer", "target": "Metaclass", "slot": "class", "value": "MetaclassClass" },
    { "op": "patchPointer", "target": "UndefinedObject", "slot": "class", "value": "UndefinedObjectClass" },
    { "op": "patchPointer", "target": "nil", "slot": "class", "value": "UndefinedObject" },
    { "op": "patchPointer", "target": "SmallInteger", "slot": "class", "value": "SmallIntegerClass" },
    { "op": "patchPointer", "target": "Symbol", "slot": "class", "value": "SymbolClass" },
    { "op": "patchPointer", "target": "Array", "slot": "class", "value": "ArrayClass" },
    { "op": "patchPointer", "target": "ByteArray", "slot": "class", "value": "ByteArrayClass" },
    { "op": "patchPointer", "target": "CompiledMethod", "slot": "class", "value": "CompiledMethodClass" },
    { "op": "patchPointer", "target": "MethodDictionary", "slot": "class", "value": "MethodDictionaryClass" },
    { "op": "patchPointer", "target": "Association", "slot": "class", "value": "AssociationClass" },

    { "comment": "=== SET METACLASS POINTERS ===" },
    { "op": "patchPointer", "target": "ProtoObjectClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "ObjectClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "BehaviorClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "ClassDescriptionClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "ClassClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "MetaclassClass", "slot": "class", "value": "MetaclassClass" },
    { "op": "patchPointer", "target": "UndefinedObjectClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "SmallIntegerClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "SymbolClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "ArrayClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "ByteArrayClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "CompiledMethodClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "MethodDictionaryClass", "slot": "class", "value": "Metaclass" },
    { "op": "patchPointer", "target": "AssociationClass", "slot": "class", "value": "Metaclass" },

    { "comment": "=== SET SUPERCLASS CHAINS ===" },
    { "op": "setSuperclass", "target": "ProtoObject", "value": null },
    { "op": "setSuperclass", "target": "Object", "value": "ProtoObject" },
    { "op": "setSuperclass", "target": "UndefinedObject", "value": "Object" },
    { "op": "setSuperclass", "target": "Behavior", "value": "Object" },
    { "op": "setSuperclass", "target": "ClassDescription", "value": "Behavior" },
    { "op": "setSuperclass", "target": "Class", "value": "ClassDescription" },
    { "op": "setSuperclass", "target": "Metaclass", "value": "ClassDescription" },
    { "op": "setSuperclass", "target": "SmallInteger", "value": "Object" },
    { "op": "setSuperclass", "target": "Symbol", "value": "Object" },
    { "op": "setSuperclass", "target": "Array", "value": "Object" },
    { "op": "setSuperclass", "target": "ByteArray", "value": "Array" },
    { "op": "setSuperclass", "target": "CompiledMethod", "value": "Object" },
    { "op": "setSuperclass", "target": "MethodDictionary", "value": "Object" },
    { "op": "setSuperclass", "target": "Association", "value": "Object" },

    { "op": "setSuperclass", "target": "ProtoObjectClass", "value": "Class" },
    { "op": "setSuperclass", "target": "ObjectClass", "value": "ProtoObjectClass" },
    { "op": "setSuperclass", "target": "UndefinedObjectClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "BehaviorClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "ClassDescriptionClass", "value": "BehaviorClass" },
    { "op": "setSuperclass", "target": "ClassClass", "value": "ClassDescriptionClass" },
    { "op": "setSuperclass", "target": "MetaclassClass", "value": "ClassDescriptionClass" },
    { "op": "setSuperclass", "target": "SmallIntegerClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "SymbolClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "ArrayClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "ByteArrayClass", "value": "ArrayClass" },
    { "op": "setSuperclass", "target": "CompiledMethodClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "MethodDictionaryClass", "value": "ObjectClass" },
    { "op": "setSuperclass", "target": "AssociationClass", "value": "ObjectClass" },

    { "comment": "=== SET INSTANCE VARIABLES ===" },
    { "op": "setInstanceVariables", "target": "Behavior", "value": ["superclass", "methodDict", "format"] },
    { "op": "setInstanceVariables", "target": "ClassDescription", "value": ["instanceVariables", "organization"] },
    { "op": "setInstanceVariables", "target": "Class", "value": ["name", "classPool", "sharedPools"] },
    { "op": "setInstanceVariables", "target": "Metaclass", "value": ["thisClass"] },
    { "op": "setInstanceVariables", "target": "CompiledMethod", "value": ["selector", "bytecode", "literals", "header"] },
    { "op": "setInstanceVariables", "target": "MethodDictionary", "value": ["keys", "values"] },
    { "op": "setInstanceVariables", "target": "Association", "value": ["key", "value"] },

    { "comment": "=== LINK METACLASSES TO INSTANCES ===" },
    { "op": "setSlot", "target": "ProtoObjectClass", "slot": "thisClass", "value": "ProtoObject" },
    { "op": "setSlot", "target": "ObjectClass", "slot": "thisClass", "value": "Object" },
    { "op": "setSlot", "target": "BehaviorClass", "slot": "thisClass", "value": "Behavior" },
    { "op": "setSlot", "target": "ClassDescriptionClass", "slot": "thisClass", "value": "ClassDescription" },
    { "op": "setSlot", "target": "ClassClass", "slot": "thisClass", "value": "Class" },
    { "op": "setSlot", "target": "MetaclassClass", "slot": "thisClass", "value": "Metaclass" },
    { "op": "setSlot", "target": "UndefinedObjectClass", "slot": "thisClass", "value": "UndefinedObject" },
    { "op": "setSlot", "target": "SmallIntegerClass", "slot": "thisClass", "value": "SmallInteger" },
    { "op": "setSlot", "target": "SymbolClass", "slot": "thisClass", "value": "Symbol" },
    { "op": "setSlot", "target": "ArrayClass", "slot": "thisClass", "value": "Array" },
    { "op": "setSlot", "target": "ByteArrayClass", "slot": "thisClass", "value": "ByteArray" },
    { "op": "setSlot", "target": "CompiledMethodClass", "slot": "thisClass", "value": "CompiledMethod" },
    { "op": "setSlot", "target": "MethodDictionaryClass", "slot": "thisClass", "value": "MethodDictionary" },
    { "op": "setSlot", "target": "AssociationClass", "slot": "thisClass", "value": "Association" },

    { "comment": "=== SET CLASS NAMES ===" },
    { "op": "setSlot", "target": "ProtoObject", "slot": "name", "value": "ProtoObject" },
    { "op": "setSlot", "target": "Object", "slot": "name", "value": "Object" },
    { "op": "setSlot", "target": "Behavior", "slot": "name", "value": "Behavior" },
    { "op": "setSlot", "target": "ClassDescription", "slot": "name", "value": "ClassDescription" },
    { "op": "setSlot", "target": "Class", "slot": "name", "value": "Class" },
    { "op": "setSlot", "target": "Metaclass", "slot": "name", "value": "Metaclass" },
    { "op": "setSlot", "target": "UndefinedObject", "slot": "name", "value": "UndefinedObject" },
    { "op": "setSlot", "target": "SmallInteger", "slot": "name", "value": "SmallInteger" },
    { "op": "setSlot", "target": "Symbol", "slot": "name", "value": "Symbol" },
    { "op": "setSlot", "target": "Array", "slot": "name", "value": "Array" },
    { "op": "setSlot", "target": "ByteArray", "slot": "name", "value": "ByteArray" },
    { "op": "setSlot", "target": "CompiledMethod", "slot": "name", "value": "CompiledMethod" },
    { "op": "setSlot", "target": "MethodDictionary", "slot": "name", "value": "MethodDictionary" },
    { "op": "setSlot", "target": "Association", "slot": "name", "value": "Association" },

    { "comment": "=== CRITICAL METHODS FOR CLASS CREATION ===" },
    
    { "comment": "-- Metaclass class methods --" },
    { "op": "installMethod", "target": "MetaclassClass", "selector": "new",
      "source": "new\n\t\"Create a new metaclass\"\n\t<primitive: 70>\n\t^self primitiveFailed" },
    
    { "comment": "-- Metaclass instance methods --" },
    { "op": "installMethod", "target": "Metaclass", "selector": "superclass:",
      "source": "superclass: aClass\n\t\"Set my superclass\"\n\tsuperclass := aClass" },
    
    { "op": "installMethod", "target": "Metaclass", "selector": "methodDictionary:",
      "source": "methodDictionary: aDict\n\t\"Set my method dictionary\"\n\tmethodDict := aDict" },
    
    { "op": "installMethod", "target": "Metaclass", "selector": "format:",
      "source": "format: anInteger\n\t\"Set my format\"\n\tformat := anInteger" },
    
    { "op": "installMethod", "target": "Metaclass", "selector": "thisClass:",
      "source": "thisClass: aClass\n\t\"Set the class I am metaclass of\"\n\tthisClass := aClass" },
    
    { "comment": "-- Behavior class methods --" },
    { "op": "installMethod", "target": "BehaviorClass", "selector": "new",
      "source": "new\n\t\"Create an instance of the receiver\"\n\t<primitive: 70>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "BehaviorClass", "selector": "basicNew",
      "source": "basicNew\n\t\"Primitive instance creation\"\n\t<primitive: 70>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "BehaviorClass", "selector": "basicNew:",
      "source": "basicNew: size\n\t\"Primitive indexed instance creation\"\n\t<primitive: 71>\n\t^self primitiveFailed" },
    
    { "comment": "-- Behavior instance methods --" },
    { "op": "installMethod", "target": "Behavior", "selector": "superclass:",
      "source": "superclass: aClass\n\t\"Set my superclass\"\n\tsuperclass := aClass" },
    
    { "op": "installMethod", "target": "Behavior", "selector": "methodDictionary:",
      "source": "methodDictionary: aDict\n\t\"Set my method dictionary\"\n\tmethodDict := aDict" },
    
    { "op": "installMethod", "target": "Behavior", "selector": "format:",
      "source": "format: anInteger\n\t\"Set my format\"\n\tformat := anInteger" },
    
    { "op": "installMethod", "target": "Behavior", "selector": "methodDict",
      "source": "methodDict\n\t\"Answer my method dictionary\"\n\t^methodDict" },
    
    { "comment": "-- Class instance methods --" },
    { "op": "installMethod", "target": "Class", "selector": "name:",
      "source": "name: aSymbol\n\t\"Set my name\"\n\tname := aSymbol" },
    
    { "op": "installMethod", "target": "Class", "selector": "class:",
      "source": "class: aMetaclass\n\t\"Set my metaclass\"\n\tself instVarAt: 0 put: aMetaclass" },
    
    { "comment": "-- MethodDictionary class methods --" },
    { "op": "installMethod", "target": "MethodDictionaryClass", "selector": "new",
      "source": "new\n\t\"Create a new method dictionary\"\n\t| dict |\n\tdict := self basicNew: 2.\n\tdict instVarAt: 1 put: (Array new: 32).\n\tdict instVarAt: 2 put: (Array new: 32).\n\t^dict" },
    
    { "comment": "-- MethodDictionary instance methods --" },
    { "op": "installMethod", "target": "MethodDictionary", "selector": "at:put:",
      "source": "at: key put: value\n\t\"Store value at key\"\n\t<primitive: 461>\n\t| index |\n\tindex := self findIndexFor: key.\n\tkeys at: index put: key.\n\tvalues at: index put: value.\n\t^value" },
    
    { "op": "installMethod", "target": "MethodDictionary", "selector": "at:",
      "source": "at: key\n\t\"Answer value at key\"\n\t| index |\n\tindex := self findIndexFor: key.\n\t(keys at: index) = key ifTrue: [^values at: index].\n\t^nil" },
    
    { "op": "installMethod", "target": "MethodDictionary", "selector": "findIndexFor:",
      "source": "findIndexFor: key\n\t\"Find index for key using linear search\"\n\t1 to: keys size do: [:i |\n\t\t(keys at: i) isNil ifTrue: [^i].\n\t\t(keys at: i) = key ifTrue: [^i]].\n\t^1" },
    
    { "comment": "-- CompiledMethod class methods --" },
    { "op": "installMethod", "target": "CompiledMethodClass", "selector": "new",
      "source": "new\n\t\"Create a new compiled method\"\n\t^self basicNew: 4" },
    
    { "comment": "-- CompiledMethod instance methods --" },
    { "op": "installMethod", "target": "CompiledMethod", "selector": "selector:",
      "source": "selector: aSymbol\n\t\"Set my selector\"\n\tselector := aSymbol" },
    
    { "op": "installMethod", "target": "CompiledMethod", "selector": "bytecodes:",
      "source": "bytecodes: aByteArray\n\t\"Set my bytecodes\"\n\tbytecode := aByteArray" },
    
    { "op": "installMethod", "target": "CompiledMethod", "selector": "literals:",
      "source": "literals: anArray\n\t\"Set my literals\"\n\tliterals := anArray" },
    
    { "op": "installMethod", "target": "CompiledMethod", "selector": "primitive:",
      "source": "primitive: anInteger\n\t\"Set my primitive number in header\"\n\theader := anInteger" },
    
    { "op": "installMethod", "target": "CompiledMethod", "selector": "methodClass:",
      "source": "methodClass: aClass\n\t\"Set the class I belong to\"\n\tself instVarAt: 5 put: aClass" },
    
    { "comment": "-- Array/ByteArray methods --" },
    { "op": "installMethod", "target": "ArrayClass", "selector": "new:",
      "source": "new: size\n\t\"Create array of size\"\n\t^self basicNew: size" },
    
    { "op": "installMethod", "target": "Array", "selector": "at:",
      "source": "at: index\n\t\"Answer element at index\"\n\t<primitive: 60>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "Array", "selector": "at:put:",
      "source": "at: index put: value\n\t\"Store value at index\"\n\t<primitive: 61>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "Array", "selector": "size",
      "source": "size\n\t\"Answer my size\"\n\t<primitive: 62>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "ByteArrayClass", "selector": "new:",
      "source": "new: size\n\t\"Create byte array of size\"\n\t^self basicNew: size" },
    
    { "comment": "-- Symbol methods --" },
    { "op": "installMethod", "target": "SymbolClass", "selector": "intern:",
      "source": "intern: aString\n\t\"Return interned symbol\"\n\t<primitive: 181>\n\t^self new: aString" },
    
    { "comment": "-- Object basics --" },
    { "op": "installMethod", "target": "Object", "selector": "class",
      "source": "class\n\t\"Answer my class\"\n\t<primitive: 111>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "Object", "selector": "instVarAt:",
      "source": "instVarAt: index\n\t\"Answer instance variable at index\"\n\t<primitive: 73>\n\t^self primitiveFailed" },
    
    { "op": "installMethod", "target": "Object", "selector": "instVarAt:put:",
      "source": "instVarAt: index put: value\n\t\"Set instance variable at index\"\n\t<primitive: 74>\n\t^self primitiveFailed" },
    
    { "comment": "=== REGISTER GLOBALS ===" },
    { "op": "registerGlobal", "name": "ProtoObject", "value": "ProtoObject" },
    { "op": "registerGlobal", "name": "Object", "value": "Object" },
    { "op": "registerGlobal", "name": "Behavior", "value": "Behavior" },
    { "op": "registerGlobal", "name": "ClassDescription", "value": "ClassDescription" },
    { "op": "registerGlobal", "name": "Class", "value": "Class" },
    { "op": "registerGlobal", "name": "Metaclass", "value": "Metaclass" },
    { "op": "registerGlobal", "name": "UndefinedObject", "value": "UndefinedObject" },
    { "op": "registerGlobal", "name": "nil", "value": "nil" },
    { "op": "registerGlobal", "name": "SmallInteger", "value": "SmallInteger" },
    { "op": "registerGlobal", "name": "Symbol", "value": "Symbol" },
    { "op": "registerGlobal", "name": "Array", "value": "Array" },
    { "op": "registerGlobal", "name": "ByteArray", "value": "ByteArray" },
    { "op": "registerGlobal", "name": "CompiledMethod", "value": "CompiledMethod" },
    { "op": "registerGlobal", "name": "MethodDictionary", "value": "MethodDictionary" },
    { "op": "registerGlobal", "name": "Association", "value": "Association" },
    { "op": "registerGlobal", "name": "Smalltalk", "value": "SystemDictionary" }
  ]
}