{
  "$schema": "./bootstrap-schema.json",
  "phase": "3",
  "description": "Test manifest for MethodDictionary capacity expansion",
  "testSequence": [
    {
      "comment": "Create a new MethodDictionary instance",
      "action": "sendMessage",
      "receiver": "MethodDictionary",
      "selector": "new",
      "assignTo": "testDict"
    },
    {
      "comment": "Add first key-value pair",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:put:",
      "arguments": ["sym_first", "1"]
    },
    {
      "comment": "Add second key-value pair",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:put:",
      "arguments": ["sym_second", "2"]
    },
    {
      "comment": "Add third key-value pair - should trigger expansion if capacity is 2",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:put:",
      "arguments": ["sym_third", "3"]
    },
    {
      "comment": "Add fourth key-value pair",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:put:",
      "arguments": ["sym_fourth", "4"]
    },
    {
      "comment": "Verify first entry is still accessible",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:",
      "arguments": ["sym_first"],
      "expectResult": "1"
    },
    {
      "comment": "Verify second entry is still accessible",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:",
      "arguments": ["sym_second"],
      "expectResult": "2"
    },
    {
      "comment": "Verify third entry is accessible",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:",
      "arguments": ["sym_third"],
      "expectResult": "3"
    },
    {
      "comment": "Verify fourth entry is accessible",
      "action": "sendMessage",
      "receiver": "testDict",
      "selector": "at:",
      "arguments": ["sym_fourth"],
      "expectResult": "4"
    }
  ]
}