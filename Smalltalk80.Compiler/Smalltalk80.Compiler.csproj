<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Smalltalk80.Compiler</AssemblyName>
    <RootNamespace>Smalltalk80.Compiler</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>Smalltalk-80 Compiler Library - ANTLR4-based parser and bytecode compiler</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80\Smalltalk80.csproj" />
  </ItemGroup>

</Project>