<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Smalltalk80.Compiler</AssemblyName>
    <RootNamespace>Smalltalk80.Compiler</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <!-- Suppress CS3021 warnings from ANTLR-generated files -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
    <!--  Fix duplicate assembly attribute errors - disable auto-generation entirely -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>
  
  <!-- Grammar file included for reference -->
  <ItemGroup>
    <None Include="Grammar\Smalltalk80.g4" />
    <None Include="ANTLR4\antlr-4.13.2-complete.jar" />
  </ItemGroup>

  <!-- Exclude Generated folder and UnitTests from automatic inclusion -->
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Remove="UnitTests\**" />
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <!-- Explicitly include generated files after they're created -->
  <ItemGroup>
    <Compile Include="Generated\*.cs" />
  </ItemGroup>

  <!-- Link to shared bytecode definitions -->
  <ItemGroup>
    <Compile Include="..\Shared\Core\Bytecodes\BytecodeDefinitions.cs" Link="Core\Bytecodes\BytecodeDefinitions.cs" />
  </ItemGroup>

  <!-- Ensure Generated folder exists and regenerate parser if needed -->
  <Target Name="EnsureGeneratedFiles"
          BeforeTargets="BeforeCompile"
          Inputs="Grammar\Smalltalk80.g4"
          Outputs="Generated\Smalltalk80Parser.cs">

    <Message Text="Parser files not found. Generating..." Importance="high"
             Condition="!Exists('Generated\Smalltalk80Parser.cs')" />
    <Message Text="Grammar file is newer than parser. Regenerating..." Importance="high"
             Condition="Exists('Generated\Smalltalk80Parser.cs')" />

    <!-- Create Generated folder if it doesn't exist -->
    <MakeDir Directories="$(MSBuildProjectDirectory)\Generated" Condition="!Exists('$(MSBuildProjectDirectory)\Generated')" />

    <!-- Run parser generation -->
    <Exec Command="pwsh -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateIfNewer.ps1&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  
  <!-- Clean target to remove generated files -->
  <Target Name="CleanGenerated" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)\Generated\*.*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\Generated" ContinueOnError="true" />
  </Target>

  <!-- Post-build: Run compiler tests -->
  <Target Name="RunCompilerTests" AfterTargets="Build" Condition="'$(RunCompilerTests)'!='false'">
    <Message Text="========================================" Importance="high" />
    <Message Text="Running Compiler Test Suite" Importance="high" />
    <Message Text="========================================" Importance="high" />

    <!-- Compile test source files -->
    <Message Text="" Importance="high" />
    <Message Text="[1/3] Compiling test source files..." Importance="high" />

    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;Tests/TestSources/SimpleClass.st&quot; &quot;$(OutDir)test_SimpleClass.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false">
      <Output TaskParameter="ExitCode" PropertyName="SimpleClassExitCode" />
    </Exec>
    <Message Text="  ✓ SimpleClass.st compiled" Importance="high"
             Condition="'$(SimpleClassExitCode)'=='0'" />

    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;Tests/TestSources/ControlStructures.st&quot; &quot;$(OutDir)test_ControlStructures.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false">
      <Output TaskParameter="ExitCode" PropertyName="ControlStructuresExitCode" />
    </Exec>
    <Message Text="  ✓ ControlStructures.st compiled" Importance="high"
             Condition="'$(ControlStructuresExitCode)'=='0'" />
    
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;Tests/TestSources/ComplexExpressions.st&quot; &quot;$(OutDir)test_ComplexExpressions.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false">
      <Output TaskParameter="ExitCode" PropertyName="ComplexExpressionsExitCode" />
    </Exec>
    <Message Text="  ✓ ComplexExpressions.st compiled" Importance="high"
             Condition="'$(ComplexExpressionsExitCode)'=='0'" />

    <!-- Run validation if Python is available -->
    <Message Text="" Importance="high" />
    <Message Text="[2/3] Running semantic validation..." Importance="high" />

    <Exec Command="python --version"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="PythonAvailable" />
    </Exec>

    <Message Text="  Python not found - skipping validation (install Python 3.8+ to enable)" Importance="high"
             Condition="'$(PythonAvailable)'!='0'" />

    <Exec Command="python &quot;$(MSBuildProjectDirectory)/Tests/Scripts/test_compiler_suite.py&quot; &quot;$(OutDir)test_SimpleClass.json&quot; &quot;$(OutDir)test_ControlStructures.json&quot; &quot;$(OutDir)test_ComplexExpressions.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true"
          Condition="'$(PythonAvailable)'=='0'">
      <Output TaskParameter="ExitCode" PropertyName="ValidationExitCode" />
    </Exec>

    <Message Text="  ✓ Validation passed - all tests successful" Importance="high"
             Condition="'$(PythonAvailable)'=='0' AND '$(ValidationExitCode)'=='0'" />
    <Warning Text="  Validation failed - see output above for details"
             Condition="'$(PythonAvailable)'=='0' AND '$(ValidationExitCode)'!='0'" />

    <!-- Summary -->
    <Message Text="" Importance="high" />
    <Message Text="[3/3] Test Summary:" Importance="high" />
    <Message Text="  • Test files compiled: 3/3" Importance="high" />
    <Message Text="  • Validation: $(ValidationExitCode) errors" Importance="high"
             Condition="'$(PythonAvailable)'=='0' AND '$(ValidationExitCode)'=='0'" />
    <Message Text="  • Validation: Passed" Importance="high"
             Condition="'$(PythonAvailable)'=='0' AND '$(ValidationExitCode)'=='0'" />
    <Message Text="  • Validation: Skipped (Python not available)" Importance="high"
             Condition="'$(PythonAvailable)'!='0'" />

    <Message Text="========================================" Importance="high" />
    <Message Text="✓ Compiler tests completed" Importance="high" />
    <Message Text="========================================" Importance="high" />
    <Message Text="" Importance="high" />

    <!-- Note: We don't fail the build on validation errors, just warn -->
  </Target>

  <!-- Allow skipping tests with: dotnet build -p:RunCompilerTests=false -->
  <PropertyGroup>
    <RunCompilerTests Condition="'$(RunCompilerTests)'==''">true</RunCompilerTests>
  </PropertyGroup>

</Project>