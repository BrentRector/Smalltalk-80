    [Fact]
    public void Test_OrderedCollection_Class()
    {
        var testScript = @"
""Test OrderedCollection class""
| oc testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: OrderedCollection new""
totalTests := totalTests + 1.
oc := OrderedCollection new.
oc notNil ifTrue: [testsPassed := testsPassed + 1].

""Test 2: OrderedCollection add:""
totalTests := totalTests + 1.
oc add: 'first'.
oc add: 'second'.
(oc size = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: OrderedCollection at:""
totalTests := totalTests + 1.
((oc at: 1) = 'first') ifTrue: [testsPassed := testsPassed + 1].

""Test 4: OrderedCollection addFirst:""
totalTests := totalTests + 1.
oc addFirst: 'zero'.
((oc at: 1) = 'zero') ifTrue: [testsPassed := testsPassed + 1].

""Test 5: OrderedCollection addLast:""
totalTests := totalTests + 1.
oc addLast: 'third'.
((oc at: oc size) = 'third') ifTrue: [testsPassed := testsPassed + 1].

""Test 6: OrderedCollection removeFirst""
totalTests := totalTests + 1.
| removed |
removed := oc removeFirst.
(removed = 'zero' and: [(oc at: 1) = 'first']) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: OrderedCollection removeLast""
totalTests := totalTests + 1.
removed := oc removeLast.
(removed = 'third' and: [oc size = 2]) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: OrderedCollection do:""
totalTests := totalTests + 1.
| result |
result := ''.
oc do: [:each | result := result , each].
(result = 'firstsecond') ifTrue: [testsPassed := testsPassed + 1].

""Test 9: OrderedCollection select:""
totalTests := totalTests + 1.
| selected |
oc add: 'first'.
selected := oc select: [:each | each = 'first'].
(selected size = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: OrderedCollection collect:""
totalTests := totalTests + 1.
| collected |
collected := oc collect: [:each | each size].
((collected at: 1) = 5) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'OrderedCollection Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("OrderedCollection", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"OrderedCollection tests failed:\n{result.Output}\nError: {result.Error}");
    }

    [Fact]
    public void Test_Set_Class()
    {
        var testScript = @"
""Test Set class""
| set testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: Set new""
totalTests := totalTests + 1.
set := Set new.
set notNil ifTrue: [testsPassed := testsPassed + 1].

""Test 2: Set add:""
totalTests := totalTests + 1.
set add: 'item1'.
set add: 'item2'.
set add: 'item1'. ""duplicate""
(set size = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: Set includes:""
totalTests := totalTests + 1.
(set includes: 'item1') ifTrue: [testsPassed := testsPassed + 1].

""Test 4: Set remove:""
totalTests := totalTests + 1.
set remove: 'item2'.
((set includes: 'item2') not and: [set size = 1]) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: Set do:""
totalTests := totalTests + 1.
| count |
count := 0.
set do: [:each | count := count + 1].
(count = 1) ifTrue: [testsPassed := testsPassed + 1].

""Test 6: Set collect:""
totalTests := totalTests + 1.
| newSet |
set add: 'item2'.
newSet := set collect: [:each | each size].
(newSet includes: 5) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Set select:""
totalTests := totalTests + 1.
| selected |
selected := set select: [:each | each = 'item1'].
(selected size = 1) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Set occurrencesOf:""
totalTests := totalTests + 1.
((set occurrencesOf: 'item1') = 1) ifTrue: [testsPassed := testsPassed + 1].

""Test 9: Set isEmpty / notEmpty""
totalTests := totalTests + 1.
(set notEmpty and: [(Set new) isEmpty]) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Set asArray""
totalTests := totalTests + 1.
| arr |
arr := set asArray.
(arr isKindOf: Array) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'Set Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("Set", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Set tests failed:\n{result.Output}\nError: {result.Error}");
    }

    [Fact]
    public void Test_Interval_Class()
    {
        var testScript = @"
""Test Interval class""
| interval testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: Interval from:to:""
totalTests := totalTests + 1.
interval := Interval from: 1 to: 10.
(interval size = 10) ifTrue: [testsPassed := testsPassed + 1].

""Test 2: Interval from:to:by:""
totalTests := totalTests + 1.
interval := Interval from: 0 to: 10 by: 2.
(interval size = 6) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: Interval at:""
totalTests := totalTests + 1.
((interval at: 1) = 0) ifTrue: [testsPassed := testsPassed + 1].
 
""Test 4: Interval at: second element""
totalTests := totalTests + 1.
((interval at: 2) = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: Interval first""
totalTests := totalTests + 1.
(interval first = 0) ifTrue: [testsPassed := testsPassed + 1].

""Test 6: Interval last""
totalTests := totalTests + 1.
(interval last = 10) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Interval do:""
totalTests := totalTests + 1.
| sum |
sum := 0.
(1 to: 5) do: [:each | sum := sum + each].
(sum = 15) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Interval includes:""
totalTests := totalTests + 1.
((1 to: 10) includes: 5) ifTrue: [testsPassed := testsPassed + 1].

""Test 9: Interval collect:""
totalTests := totalTests + 1.
| squared |
squared := (1 to: 3) collect: [:each | each * each].
((squared at: 3) = 9) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Interval reverseDo:""
totalTests := totalTests + 1.
| result |
result := OrderedCollection new.
(1 to: 3) reverseDo: [:each | result add: each].
((result at: 1) = 3) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'Interval Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("Interval", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Interval tests failed:\n{result.Output}\nError: {result.Error}");
    }

    // ============================================
