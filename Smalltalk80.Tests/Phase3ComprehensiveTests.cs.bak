    [Fact]
    public void Test_ReadStream_Class()
    {
        var testScript = @"
""Test ReadStream class""
| stream testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: ReadStream on:""
totalTests := totalTests + 1.
stream := ReadStream on: 'Hello World'.
stream notNil ifTrue: [testsPassed := testsPassed + 1].

""Test 2: ReadStream next""
totalTests := totalTests + 1.
(stream next = $H) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: ReadStream next: multiple""
totalTests := totalTests + 1.
((stream next: 4) = 'ello') ifTrue: [testsPassed := testsPassed + 1].

""Test 4: ReadStream peek""
totalTests := totalTests + 1.
(stream peek = $ ) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: ReadStream position""
totalTests := totalTests + 1.
(stream position = 5) ifTrue: [testsPassed := testsPassed + 1].

""Test 6: ReadStream position:""
totalTests := totalTests + 1.
stream position: 0.
(stream position = 0) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: ReadStream upTo:""
totalTests := totalTests + 1.
((stream upTo: $ ) = 'Hello') ifTrue: [testsPassed := testsPassed + 1].

""Test 8: ReadStream atEnd""
totalTests := totalTests + 1.
stream position: 11.
stream atEnd ifTrue: [testsPassed := testsPassed + 1].

""Test 9: ReadStream reset""
totalTests := totalTests + 1.
stream reset.
(stream position = 0) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: ReadStream contents""
totalTests := totalTests + 1.
(stream contents = 'Hello World') ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'ReadStream Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("ReadStream", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"ReadStream tests failed:\n{result.Output}\nError: {result.Error}");
    }

    [Fact]
    public void Test_WriteStream_Class()
    {
        var testScript = @"
""Test WriteStream class""
| stream testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: WriteStream on:""
totalTests := totalTests + 1.
stream := WriteStream on: (String new: 20).
stream notNil ifTrue: [testsPassed := testsPassed + 1].

""Test 2: WriteStream nextPut:""
totalTests := totalTests + 1.
stream nextPut: $H.
stream nextPut: $i.
(stream contents = 'Hi') ifTrue: [testsPassed := testsPassed + 1].

""Test 3: WriteStream nextPutAll:""
totalTests := totalTests + 1.
stream nextPutAll: ' there'.
(stream contents = 'Hi there') ifTrue: [testsPassed := testsPassed + 1].

""Test 4: WriteStream space""
totalTests := totalTests + 1.
stream space.
((stream contents at: stream position) = $ ) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: WriteStream cr""
totalTests := totalTests + 1.
| oldSize |
oldSize := stream position.
stream cr.
(stream position = (oldSize + 1)) ifTrue: [testsPassed := testsPassed + 1].

""Test 6: WriteStream tab""
totalTests := totalTests + 1.
oldSize := stream position.
stream tab.
(stream position = (oldSize + 1)) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: WriteStream position""
totalTests := totalTests + 1.
stream position: 2.
(stream position = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: WriteStream reset""
totalTests := totalTests + 1.
stream reset.
(stream position = 0) ifTrue: [testsPassed := testsPassed + 1].

""Test 9: WriteStream size""
totalTests := totalTests + 1.
stream nextPutAll: 'Test'.
(stream size = 4) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: WriteStream contents""
totalTests := totalTests + 1.
(stream contents = 'Test') ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'WriteStream Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("WriteStream", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"WriteStream tests failed:\n{result.Output}\nError: {result.Error}");
    }

    // ============================================
    // Master Test Runner
    // ============================================

    [Fact]
    public void Run_All_Phase3_Tests()
    {
        var masterScript = @"
""Master test runner for all Phase 0-3 classes""
| totalTests totalPassed testResults |

totalTests := 0.
totalPassed := 0.
testResults := OrderedCollection new.

""Helper method to run a test block""
| runTest |
runTest := [:testName :testBlock |
    | testsPassed testsTotal |
    testsPassed := 0.
    testsTotal := 0.
    testBlock value.
    testResults add: (Array with: testName with: testsPassed with: testsTotal).
    totalTests := totalTests + testsTotal.
    totalPassed := totalPassed + testsPassed.
].

""Run all test suites""

""Phase 1 Core Classes""
runTest value: 'Object' value: [
    | obj |
    testsTotal := 3.
    obj := Object new.
    obj notNil ifTrue: [testsPassed := testsPassed + 1].
    (obj class == Object) ifTrue: [testsPassed := testsPassed + 1].
    (obj == obj) ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'Array' value: [
    | arr |
    testsTotal := 3.
    arr := Array new: 3.
    (arr size = 3) ifTrue: [testsPassed := testsPassed + 1].
    arr at: 1 put: 'test'.
    ((arr at: 1) = 'test') ifTrue: [testsPassed := testsPassed + 1].
    arr notEmpty ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'String' value: [
    testsTotal := 3.
    ('hello' size = 5) ifTrue: [testsPassed := testsPassed + 1].
    (('hi' , ' there') = 'hi there') ifTrue: [testsPassed := testsPassed + 1].
    ('test' asSymbol == #test) ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'Dictionary' value: [
    | dict |
    testsTotal := 3.
    dict := Dictionary new.
    dict at: 'key' put: 'value'.
    ((dict at: 'key') = 'value') ifTrue: [testsPassed := testsPassed + 1].
    (dict includesKey: 'key') ifTrue: [testsPassed := testsPassed + 1].
    (dict size = 1) ifTrue: [testsPassed := testsPassed + 1].
].

""Phase 2 Classes""
runTest value: 'Boolean' value: [
    testsTotal := 3.
    (true and: [true]) ifTrue: [testsPassed := testsPassed + 1].
    (false or: [true]) ifTrue: [testsPassed := testsPassed + 1].
    false not ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'SmallInteger' value: [
    testsTotal := 3.
    (3 + 4 = 7) ifTrue: [testsPassed := testsPassed + 1].
    (10 - 3 = 7) ifTrue: [testsPassed := testsPassed + 1].
    (6 * 7 = 42) ifTrue: [testsPassed := testsPassed + 1].
].

""Phase 3 Classes""
runTest value: 'OrderedCollection' value: [
    | oc |
    testsTotal := 3.
    oc := OrderedCollection new.
    oc add: 'first'.
    (oc size = 1) ifTrue: [testsPassed := testsPassed + 1].
    ((oc at: 1) = 'first') ifTrue: [testsPassed := testsPassed + 1].
    oc addLast: 'second'.
    (oc size = 2) ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'Set' value: [
    | set |
    testsTotal := 3.
    set := Set new.
    set add: 'item'.
    set add: 'item'.
    (set size = 1) ifTrue: [testsPassed := testsPassed + 1].
    (set includes: 'item') ifTrue: [testsPassed := testsPassed + 1].
    set remove: 'item'.
    set isEmpty ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'ReadStream' value: [
    | stream |
    testsTotal := 3.
    stream := ReadStream on: 'test'.
    (stream next = $t) ifTrue: [testsPassed := testsPassed + 1].
    (stream peek = $e) ifTrue: [testsPassed := testsPassed + 1].
    stream reset.
    (stream position = 0) ifTrue: [testsPassed := testsPassed + 1].
].

runTest value: 'WriteStream' value: [
    | stream |
    testsTotal := 3.
    stream := WriteStream on: (String new: 10).
    stream nextPutAll: 'hi'.
    (stream contents = 'hi') ifTrue: [testsPassed := testsPassed + 1].
    stream space.
    (stream position = 3) ifTrue: [testsPassed := testsPassed + 1].
    stream reset.
    (stream position = 0) ifTrue: [testsPassed := testsPassed + 1].
].

""Print summary""
Transcript cr.
Transcript show: '=============================================='; cr.
Transcript show: 'PHASE 0-3 COMPREHENSIVE TEST RESULTS'; cr.
Transcript show: '=============================================='; cr.
Transcript cr.

testResults do: [:result |
    Transcript show: (result at: 1), ': '.
    Transcript show: (result at: 2) asString.
    Transcript show: '/'.
    Transcript show: (result at: 3) asString.
    ((result at: 2) = (result at: 3))
        ifTrue: [Transcript show: ' PASSED']
        ifFalse: [Transcript show: ' FAILED'].
    Transcript cr.
].

Transcript cr.
Transcript show: '----------------------------------------------'; cr.
Transcript show: 'TOTAL: '.
Transcript show: totalPassed asString.
Transcript show: '/'.
Transcript show: totalTests asString.
Transcript show: ' tests passed'; cr.

totalPassed = totalTests
    ifTrue: [
        Transcript cr.
        Transcript show: '*** ALL TESTS PASSED ***'; cr.
    ]
    ifFalse: [
        Transcript cr.
        Transcript show: '*** SOME TESTS FAILED ***'; cr.
    ].
";

        var result = ExecuteSmalltalkTest("MasterTestSuite", masterScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Master test suite failed:\n{result.Output}\nError: {result.Error}");
    }
}