(dict size = 2) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Dictionary removeKey:""
totalTests := totalTests + 1.
dict removeKey: 'key2'.
(dict size = 1) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Dictionary at:ifAbsent:""
