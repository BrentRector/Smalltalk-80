    [Fact]
    public void Test_Boolean_Classes()
    {
        var testScript = @"
""Test Boolean, True, and False classes""
| testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: true is True""
totalTests := totalTests + 1.
(true class == True) ifTrue: [testsPassed := testsPassed + 1].

""Test 2: false is False""
totalTests := totalTests + 1.
(false class == False) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: true ifTrue:""
totalTests := totalTests + 1.
(true ifTrue: [42]) = 42 ifTrue: [testsPassed := testsPassed + 1].

""Test 4: false ifFalse:""
totalTests := totalTests + 1.
(false ifFalse: [99]) = 99 ifTrue: [testsPassed := testsPassed + 1].

""Test 5: true ifTrue:ifFalse:""
totalTests := totalTests + 1.
(true ifTrue: [1] ifFalse: [2]) = 1 ifTrue: [testsPassed := testsPassed + 1].

""Test 6: false ifTrue:ifFalse:""
totalTests := totalTests + 1.
(false ifTrue: [1] ifFalse: [2]) = 2 ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Boolean and:""
totalTests := totalTests + 1.
(true and: [true]) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Boolean or:""
totalTests := totalTests + 1.
(false or: [true]) ifTrue: [testsPassed := testsPassed + 1].

""Test 9: Boolean not""
totalTests := totalTests + 1.
false not ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Boolean & (eager and)""
totalTests := totalTests + 1.
(true & true) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'Boolean Classes Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("Boolean", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Boolean tests failed:\n{result.Output}\nError: {result.Error}");
    }

