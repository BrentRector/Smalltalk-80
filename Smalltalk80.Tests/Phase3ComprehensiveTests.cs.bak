| result |
result := dict at: 'missing' ifAbsent: ['not found'].
(result = 'not found') ifTrue: [testsPassed := testsPassed + 1].

""Test 9: Dictionary keys""
totalTests := totalTests + 1.
| keys |
keys := dict keys.
(keys includes: 'key1') ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Dictionary do:""
totalTests := totalTests + 1.
| count |
count := 0.
dict do: [:each | count := count + 1].
(count = 1) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
