using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using Xunit;
using Xunit.Abstractions;

namespace Smalltalk80.Tests;

/// <summary>
/// Comprehensive test suite for all Phase 0-3 classes and methods.
/// Tests every class and method in the complete bootstrap system.
/// </summary>
public class Phase3ComprehensiveTests
{
    private readonly ITestOutputHelper output;
    private readonly string interpreterPath;
    private readonly string testScriptsPath;
    private readonly string phase3ManifestPath;

    public Phase3ComprehensiveTests(ITestOutputHelper output)
    {
        this.output = output;
        
        // Find the interpreter executable
        var baseDir = FindSolutionRoot();
        interpreterPath = Path.Combine(baseDir, "bin", "Debug", "net9.0", "Smalltalk80.Interpreter.exe");
        testScriptsPath = Path.Combine(baseDir, "Smalltalk80.Tests", "TestScripts", "Phase3");
        phase3ManifestPath = Path.Combine(baseDir, "bin", "Debug", "net9.0", "Bootstrap", "phase3_minimal.json");
        
        // Create test scripts directory if it doesn't exist
        Directory.CreateDirectory(testScriptsPath);
        
        // Ensure Phase 3 manifest exists
        Assert.True(File.Exists(phase3ManifestPath), $"Phase 3 manifest not found at {phase3ManifestPath}");
    }

    private static string FindSolutionRoot()
    {
        var dir = Directory.GetCurrentDirectory();
        while (dir != null && !File.Exists(Path.Combine(dir, "Smalltalk-80.sln")))
        {
            dir = Directory.GetParent(dir)?.FullName;
        }
        return dir ?? throw new InvalidOperationException("Could not find solution root");
    }

    /// <summary>
    /// Execute a Smalltalk test script and return the results.
    /// </summary>
    private TestResult ExecuteSmalltalkTest(string testName, string testScript)
    {
        var scriptPath = Path.Combine(testScriptsPath, $"{testName}.st");
        File.WriteAllText(scriptPath, testScript);

        var startInfo = new ProcessStartInfo
        {
            FileName = interpreterPath,
            Arguments = $"--extended-library Bootstrap/phase3_minimal.json \"{scriptPath}\"",
            WorkingDirectory = Path.GetDirectoryName(interpreterPath),
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };

        using var process = Process.Start(startInfo);
        var stdout = process!.StandardOutput.ReadToEnd();
        var stderr = process.StandardError.ReadToEnd();
        process.WaitForExit(10000); // 10 second timeout

        return new TestResult
        {
            Success = process.ExitCode == 0 && stdout.Contains("ALL TESTS PASSED"),
            Output = stdout,
            Error = stderr,
            ExitCode = process.ExitCode
        };
    }

    private class TestResult
    {
        public bool Success { get; set; }
        public string Output { get; set; } = "";
        public string Error { get; set; } = "";
        public int ExitCode { get; set; }
    }

    // ============================================
    // Phase 1 Core Classes Tests
    // ============================================

    [Fact]
    public void Test_Object_Class()
    {
        var testScript = @"
""Test Object class and its essential methods""
| obj1 obj2 result testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: Object new""
totalTests := totalTests + 1.
obj1 := Object new.
obj1 isNil ifFalse: [testsPassed := testsPassed + 1].

""Test 2: Object identity (==)""
totalTests := totalTests + 1.
obj2 := Object new.
(obj1 == obj1) ifTrue: [testsPassed := testsPassed + 1].

""Test 3: Object non-identity""
totalTests := totalTests + 1.
(obj1 == obj2) ifFalse: [testsPassed := testsPassed + 1].

""Test 4: Object class""
totalTests := totalTests + 1.
(obj1 class == Object) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: Object isNil""
totalTests := totalTests + 1.
obj1 isNil ifFalse: [testsPassed := testsPassed + 1].

""Test 6: Object notNil""
totalTests := totalTests + 1.
obj1 notNil ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Object yourself""
totalTests := totalTests + 1.
((obj1 yourself) == obj1) ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Object hash""
totalTests := totalTests + 1.
result := obj1 hash.
result isNil ifFalse: [testsPassed := testsPassed + 1].

""Test 9: Object = (defaults to ==)""
totalTests := totalTests + 1.
(obj1 = obj1) ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Object ~= ""
totalTests := totalTests + 1.
(obj1 ~= obj2) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'Object Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("Object", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Object tests failed:\n{result.Output}\nError: {result.Error}");
    }

    [Fact]
    public void Test_Array_Class()
    {
        var testScript = @"
""Test Array class and its methods""
| arr1 arr2 testsPassed totalTests |

testsPassed := 0.
totalTests := 0.

""Test 1: Array new:""
totalTests := totalTests + 1.
arr1 := Array new: 5.
(arr1 size = 5) ifTrue: [testsPassed := testsPassed + 1].

""Test 2: Array at:put: and at:""
totalTests := totalTests + 1.
arr1 at: 1 put: 'first'.
arr1 at: 2 put: 'second'.
((arr1 at: 1) = 'first') ifTrue: [testsPassed := testsPassed + 1].

""Test 3: Array size""
totalTests := totalTests + 1.
(arr1 size = 5) ifTrue: [testsPassed := testsPassed + 1].

""Test 4: Array with:with:""
totalTests := totalTests + 1.
arr2 := Array with: 10 with: 20.
((arr2 at: 1) = 10 and: [(arr2 at: 2) = 20]) ifTrue: [testsPassed := testsPassed + 1].

""Test 5: Array asArray""
totalTests := totalTests + 1.
(arr1 asArray == arr1) ifTrue: [testsPassed := testsPassed + 1].

""Test 6: Array do:""
totalTests := totalTests + 1.
| sum |
sum := 0.
arr2 do: [:each | sum := sum + each].
(sum = 30) ifTrue: [testsPassed := testsPassed + 1].

""Test 7: Array includes:""
totalTests := totalTests + 1.
(arr1 includes: 'first') ifTrue: [testsPassed := testsPassed + 1].

""Test 8: Array isEmpty""
totalTests := totalTests + 1.
((Array new: 0) isEmpty) ifTrue: [testsPassed := testsPassed + 1].

""Test 9: Array notEmpty""
totalTests := totalTests + 1.
arr1 notEmpty ifTrue: [testsPassed := testsPassed + 1].

""Test 10: Array copyFrom:to:""
totalTests := totalTests + 1.
| subArr |
subArr := arr1 copyFrom: 1 to: 2.
(subArr size = 2 and: [(subArr at: 1) = 'first']) ifTrue: [testsPassed := testsPassed + 1].

""Print results""
Transcript cr.
Transcript show: 'Array Class Tests: '.
Transcript show: testsPassed asString.
Transcript show: ' / '.
Transcript show: totalTests asString.
Transcript show: ' passed'.
Transcript cr.

testsPassed = totalTests 
    ifTrue: [Transcript show: 'ALL TESTS PASSED'; cr]
    ifFalse: [Transcript show: 'SOME TESTS FAILED'; cr].
";

        var result = ExecuteSmalltalkTest("Array", testScript);
        output.WriteLine(result.Output);
        Assert.True(result.Success, $"Array tests failed:\n{result.Output}\nError: {result.Error}");
    }

