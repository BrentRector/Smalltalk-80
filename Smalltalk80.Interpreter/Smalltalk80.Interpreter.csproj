<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  
  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>
  
  <!-- Only CLI files -->
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  
  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  
  <!-- Copy coldstart.json from Compiler output to Interpreter output after Compiler builds -->
  <Target Name="CopyColdStartJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Compiler outputs to shared bin directory: bin/Debug/net9.0/coldstart.json -->
      <ColdStartSource>$(OutDir)coldstart.json</ColdStartSource>
    </PropertyGroup>

    <!-- Check if coldstart.json exists in output directory -->
    <Message
      Text="coldstart.json found: $(ColdStartSource)"
      Importance="high"
      Condition="Exists('$(ColdStartSource)')" />

    <Message
      Text="coldstart.json not found: $(ColdStartSource) - run Compiler to generate it"
      Importance="high"
      Condition="!Exists('$(ColdStartSource)')" />
  </Target>


</Project>