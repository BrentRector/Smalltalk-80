<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Well-known folder paths for deployment -->
  <PropertyGroup>
    <AppName>Smalltalk-80</AppName>
    <!-- %COMMONAPPDATA% = C:\ProgramData -->
    <CommonAppDataPath>$(ALLUSERSPROFILE)\$(AppName)</CommonAppDataPath>
    <!-- %APPDATA% = C:\Users\{user}\AppData\Roaming -->
    <UserAppDataPath>$(APPDATA)\$(AppName)</UserAppDataPath>
  </PropertyGroup>

  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>

  <!-- CLI and GUI files -->
  <ItemGroup>
    <!-- Include all .cs files in root directory only (not subdirectories) -->
    <Compile Include="*.cs" />
    <!-- Include all .cs files in Platform folder and its subdirectories -->
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!--
    Deploy target: Copy files to Windows well-known folders.
    REQUIRED before running the interpreter for the first time.

    Run with: dotnet msbuild /t:Deploy

    Source locations:
    - coldstart.json: Compiler output (bin/Debug/net9.0/Data/)
    - .sources/.changes: Interpreter project directory (written by Compiler)

    Destination locations:
    - coldstart.json: %COMMONAPPDATA%\Smalltalk-80\ (system-wide, shared)
    - .sources/.changes: %APPDATA%\Smalltalk-80\ (per-user)
  -->
  <Target Name="Deploy">
    <PropertyGroup>
      <CompilerOutputDir>$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\bin\$(Configuration)\net9.0\</CompilerOutputDir>
      <!-- Source files are written by Compiler to Interpreter project directory -->
      <InterpreterProjectDir>$(MSBuildProjectDirectory)</InterpreterProjectDir>
      <!-- Full paths for source files -->
      <ColdstartSource>$(CompilerOutputDir)Data\coldstart.json</ColdstartSource>
      <SourcesSource>$(InterpreterProjectDir)\Smalltalk-80.sources</SourcesSource>
      <ChangesSource>$(InterpreterProjectDir)\Smalltalk-80.changes</ChangesSource>
    </PropertyGroup>

    <Message Text="" Importance="high" />
    <Message Text="========================================" Importance="high" />
    <Message Text="Deploying Smalltalk-80 files" Importance="high" />
    <Message Text="========================================" Importance="high" />
    <Message Text="" Importance="high" />
    <Message Text="Source locations:" Importance="high" />
    <Message Text="  coldstart.json:       $(ColdstartSource)" Importance="high" />
    <Message Text="  Smalltalk-80.sources: $(SourcesSource)" Importance="high" />
    <Message Text="  Smalltalk-80.changes: $(ChangesSource)" Importance="high" />
    <Message Text="" Importance="high" />
    <Message Text="Destination locations:" Importance="high" />
    <Message Text="  coldstart.json:       $(CommonAppDataPath)\" Importance="high" />
    <Message Text="  Smalltalk-80.sources: $(UserAppDataPath)\" Importance="high" />
    <Message Text="  Smalltalk-80.changes: $(UserAppDataPath)\" Importance="high" />
    <Message Text="" Importance="high" />

    <!-- Create target directories if they don't exist -->
    <MakeDir Directories="$(CommonAppDataPath)" Condition="!Exists('$(CommonAppDataPath)')" />
    <MakeDir Directories="$(UserAppDataPath)" Condition="!Exists('$(UserAppDataPath)')" />

    <!-- Deploy coldstart.json -->
    <Message Text="Deploying coldstart.json..." Importance="high" />
    <Copy SourceFiles="$(ColdstartSource)"
          DestinationFolder="$(CommonAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(ColdstartSource)')" />
    <Message Text="  ✓ SUCCESS" Importance="high" Condition="Exists('$(ColdstartSource)')" />
    <Warning Text="  ✗ FAILED: File not found at $(ColdstartSource)" Condition="!Exists('$(ColdstartSource)')" />

    <!-- Deploy .sources -->
    <Message Text="Deploying Smalltalk-80.sources..." Importance="high" />
    <Copy SourceFiles="$(SourcesSource)"
          DestinationFolder="$(UserAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(SourcesSource)')" />
    <Message Text="  ✓ SUCCESS" Importance="high" Condition="Exists('$(SourcesSource)')" />
    <Warning Text="  ✗ FAILED: File not found at $(SourcesSource)" Condition="!Exists('$(SourcesSource)')" />

    <!-- Deploy .changes -->
    <Message Text="Deploying Smalltalk-80.changes..." Importance="high" />
    <Copy SourceFiles="$(ChangesSource)"
          DestinationFolder="$(UserAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(ChangesSource)')" />
    <Message Text="  ✓ SUCCESS" Importance="high" Condition="Exists('$(ChangesSource)')" />
    <Warning Text="  ✗ FAILED: File not found at $(ChangesSource)" Condition="!Exists('$(ChangesSource)')" />

    <Message Text="" Importance="high" />
    <Message Text="========================================" Importance="high" />
  </Target>

</Project>