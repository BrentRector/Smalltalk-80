<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>

  <!-- CLI and GUI files -->
  <ItemGroup>
    <!-- Include all .cs files in root directory only (not subdirectories) -->
    <Compile Include="*.cs" />
    <!-- Include all .cs files in Platform folder and its subdirectories -->
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  
  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  
  <!-- Verify coldstart.json exists after build -->
  <!-- Note: Each project has its own bin/obj directories -->
  <!-- Compiler outputs to: Smalltalk80.Compiler/bin/Debug/net9.0/coldstart.json -->
  <!-- Interpreter outputs to: Smalltalk80.Interpreter/bin/Debug/net9.0-windows/ -->
  <Target Name="VerifyColdStartJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Look for coldstart.json in Compiler's output directory -->
      <CompilerOutputDir>$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\bin\$(Configuration)\net9.0\</CompilerOutputDir>
      <ColdStartFile>$(CompilerOutputDir)coldstart.json</ColdStartFile>
    </PropertyGroup>

    <!-- Check if coldstart.json exists in compiler output directory -->
    <Message
      Text="✓ coldstart.json found: $(ColdStartFile)"
      Importance="high"
      Condition="Exists('$(ColdStartFile)')" />

    <Warning
      Text="⚠ coldstart.json not found: $(ColdStartFile) - Run build-standard.ps1 or build-with-tests.ps1 to generate it"
      Condition="!Exists('$(ColdStartFile)')" />
  </Target>


</Project>