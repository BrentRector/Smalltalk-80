<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Well-known folder paths for deployment -->
  <PropertyGroup>
    <AppName>Smalltalk-80</AppName>
    <!-- %COMMONAPPDATA% = C:\ProgramData -->
    <CommonAppDataPath>$(ALLUSERSPROFILE)\$(AppName)</CommonAppDataPath>
    <!-- %APPDATA% = C:\Users\{user}\AppData\Roaming -->
    <UserAppDataPath>$(APPDATA)\$(AppName)</UserAppDataPath>
  </PropertyGroup>

  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>

  <!-- CLI and GUI files -->
  <ItemGroup>
    <!-- Include all .cs files in root directory only (not subdirectories) -->
    <Compile Include="*.cs" />
    <!-- Include all .cs files in Platform folder and its subdirectories -->
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!--
    Deploy target: Copy files to Windows well-known folders.
    Runs automatically after build. Can also run manually: dotnet msbuild /t:Deploy

    Source locations:
    - coldstart.json, .sources, .changes: Smalltalk80.Compiler/bin/{Config}/net9.0/
    - *.form files: Forms/ folder in repository root

    Destination locations:
    - coldstart.json, *.form: %COMMONAPPDATA%\Smalltalk-80\ (system-wide, shared)
    - .sources/.changes: %APPDATA%\Smalltalk-80\ (per-user)
  -->
  <Target Name="Deploy" AfterTargets="Build">
    <PropertyGroup>
      <!-- Source files in Compiler's output folder -->
      <CompilerOutputDir>$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\bin\$(Configuration)\net9.0\</CompilerOutputDir>
      <!-- Form files in repository Forms folder -->
      <FormsDir>$(MSBuildProjectDirectory)\..\Forms\</FormsDir>
      <!-- Full paths for source files -->
      <ColdstartSource>$(CompilerOutputDir)coldstart.json</ColdstartSource>
      <SourcesSource>$(CompilerOutputDir)Smalltalk-80.sources</SourcesSource>
      <ChangesSource>$(CompilerOutputDir)Smalltalk-80.changes</ChangesSource>
    </PropertyGroup>

    <!-- Collect all .form files from Forms folder -->
    <ItemGroup>
      <FormFiles Include="$(FormsDir)*.form" />
    </ItemGroup>

    <!-- Create target directories if they don't exist -->
    <MakeDir Directories="$(CommonAppDataPath)" Condition="!Exists('$(CommonAppDataPath)')" />
    <MakeDir Directories="$(UserAppDataPath)" Condition="!Exists('$(UserAppDataPath)')" />

    <Exec Command="echo Deploying Smalltalk-80 files:" />

    <!-- Deploy coldstart.json -->
    <Copy SourceFiles="$(ColdstartSource)"
          DestinationFolder="$(CommonAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(ColdstartSource)')" />
    <Exec Command="echo   coldstart.json -^&gt; $(CommonAppDataPath)\coldstart.json" Condition="Exists('$(ColdstartSource)')" />
    <Exec Command="echo   coldstart.json: FAILED - not found at $(ColdstartSource)" Condition="!Exists('$(ColdstartSource)')" />

    <!-- Deploy .sources -->
    <Copy SourceFiles="$(SourcesSource)"
          DestinationFolder="$(UserAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(SourcesSource)')" />
    <Exec Command="echo   Smalltalk-80.sources -^&gt; $(UserAppDataPath)\Smalltalk-80.sources" Condition="Exists('$(SourcesSource)')" />
    <Exec Command="echo   Smalltalk-80.sources: FAILED - not found at $(SourcesSource)" Condition="!Exists('$(SourcesSource)')" />

    <!-- Deploy .changes -->
    <Copy SourceFiles="$(ChangesSource)"
          DestinationFolder="$(UserAppDataPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(ChangesSource)')" />
    <Exec Command="echo   Smalltalk-80.changes -^&gt; $(UserAppDataPath)\Smalltalk-80.changes" Condition="Exists('$(ChangesSource)')" />
    <Exec Command="echo   Smalltalk-80.changes: FAILED - not found at $(ChangesSource)" Condition="!Exists('$(ChangesSource)')" />

    <!-- Deploy .form files -->
    <Copy SourceFiles="@(FormFiles)"
          DestinationFolder="$(CommonAppDataPath)"
          SkipUnchangedFiles="false" />
    <Exec Command="echo   *.form files (@(FormFiles-&gt;Count())) -^&gt; $(CommonAppDataPath)\" />
  </Target>

</Project>