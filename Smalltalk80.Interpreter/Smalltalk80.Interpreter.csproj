<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>
  
  <!-- CLI and GUI files -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WinFormsDisplayProvider.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  
  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  
  <!-- Verify coldstart.json exists after build -->
  <Target Name="VerifyColdStartJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Both Compiler and Interpreter output to shared bin directory: bin/Debug/net9.0/ -->
      <ColdStartFile>$(OutDir)coldstart.json</ColdStartFile>
    </PropertyGroup>

    <!-- Check if coldstart.json exists in output directory -->
    <Message
      Text="✓ coldstart.json found: $(ColdStartFile)"
      Importance="high"
      Condition="Exists('$(ColdStartFile)')" />

    <Warning
      Text="⚠ coldstart.json not found: $(ColdStartFile) - Compiler should have generated it"
      Condition="!Exists('$(ColdStartFile)')" />
  </Target>


</Project>