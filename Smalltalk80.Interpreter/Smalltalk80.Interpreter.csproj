<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>

  <!-- CLI and GUI files -->
  <ItemGroup>
    <!-- Include all .cs files in root directory only (not subdirectories) -->
    <Compile Include="*.cs" />
    <!-- Include all .cs files in Platform folder and its subdirectories -->
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  
  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  
  <!-- Copy coldstart.json to output Data folder after build -->
  <!-- Note: Compiler now outputs .sources and .changes directly to Interpreter output directory -->
  <Target Name="CopyDataFilesToOutput" AfterTargets="Build">
    <PropertyGroup>
      <CompilerOutputDir>$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\bin\$(Configuration)\net9.0\</CompilerOutputDir>
      <DataOutputDir>$(TargetDir)Data\</DataOutputDir>
    </PropertyGroup>

    <!-- Create Data directory if it doesn't exist -->
    <MakeDir Directories="$(DataOutputDir)" Condition="!Exists('$(DataOutputDir)')" />

    <!-- Copy coldstart.json from Compiler output Data folder (if freshly compiled) -->
    <Copy SourceFiles="$(CompilerOutputDir)Data\coldstart.json" DestinationFolder="$(DataOutputDir)" SkipUnchangedFiles="true" Condition="Exists('$(CompilerOutputDir)Data\coldstart.json')" />
    <Message Text="✓ Copied freshly compiled coldstart.json to $(DataOutputDir)" Importance="high" Condition="Exists('$(CompilerOutputDir)Data\coldstart.json')" />
  </Target>


</Project>