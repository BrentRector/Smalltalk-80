<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project reference to Compiler to ensure it builds first -->
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <!-- Don't copy compiler assembly to output, we only want the coldstart.json -->
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Link to shared bytecode definitions -->
  <ItemGroup>
    <Compile Include="..\Shared\Core\Bytecodes\BytecodeDefinitions.cs" Link="Core\Bytecodes\BytecodeDefinitions.cs" />
  </ItemGroup>

  <!-- Copy coldstart.json from Compiler output to Interpreter output after Compiler builds -->
  <Target Name="CopyColdStartJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Compiler outputs to shared bin directory: bin/Debug/net9.0/coldstart.json -->
      <ColdStartSource>$(OutDir)coldstart.json</ColdStartSource>
    </PropertyGroup>

    <!-- Check if coldstart.json exists in output directory -->
    <Message
      Text="coldstart.json found: $(ColdStartSource)"
      Importance="high"
      Condition="Exists('$(ColdStartSource)')" />

    <Message
      Text="coldstart.json not found: $(ColdStartSource) - run Compiler to generate it"
      Importance="high"
      Condition="!Exists('$(ColdStartSource)')" />
  </Target>

</Project>
