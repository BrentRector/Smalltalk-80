<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Reference to Engine (which references Core) -->
  <ItemGroup>
    <ProjectReference Include="Engine\Smalltalk80.Interpreter.Engine.csproj" />
  </ItemGroup>

  <!-- CLI and GUI files -->
  <ItemGroup>
    <!-- Include all .cs files in root directory only (not subdirectories) -->
    <Compile Include="*.cs" />
    <!-- Include all .cs files in Platform folder and its subdirectories -->
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!-- Windows Forms and Graphics packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  
  <!-- Preserve existing compiler integration -->
  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80.Compiler\Smalltalk80.Compiler.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  
  <!-- Copy Data files (coldstart.json, .sources, .changes) to output Data folder after build -->
  <!-- Note: Each project has its own bin/obj directories -->
  <!-- Compiler outputs to: Smalltalk80.Compiler/bin/Debug/net9.0/coldstart.json -->
  <!-- Interpreter outputs to: Smalltalk80.Interpreter/bin/Debug/net9.0-windows/ -->
  <Target Name="CopyDataFilesToOutput" AfterTargets="Build">
    <PropertyGroup>
      <!-- Source locations -->
      <CompilerOutputDir>$(MSBuildProjectDirectory)\..\Smalltalk80.Compiler\bin\$(Configuration)\net9.0\</CompilerOutputDir>
      <SmalltalkSourceDir>$(MSBuildProjectDirectory)\..\Smalltalk-80 Source\</SmalltalkSourceDir>
      <!-- Destination Data folder -->
      <DataOutputDir>$(TargetDir)Data\</DataOutputDir>
    </PropertyGroup>

    <!-- Create Data directory if it doesn't exist -->
    <MakeDir Directories="$(DataOutputDir)" Condition="!Exists('$(DataOutputDir)')" />

    <!-- Copy coldstart.json from Compiler output Data folder (if freshly compiled) -->
    <!-- Note: coldstart.json is tracked in git in the Interpreter's Data folder, so this is optional -->
    <Copy
      SourceFiles="$(CompilerOutputDir)Data\coldstart.json"
      DestinationFolder="$(DataOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(CompilerOutputDir)Data\coldstart.json')" />
    <Message
      Text="✓ Copied freshly compiled coldstart.json to $(DataOutputDir)"
      Importance="high"
      Condition="Exists('$(CompilerOutputDir)Data\coldstart.json')" />

    <!-- Copy Smalltalk-80.sources from Compiler output (generated during compilation) -->
    <Copy
      SourceFiles="$(CompilerOutputDir)Data\Smalltalk-80.sources"
      DestinationFolder="$(DataOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(CompilerOutputDir)Data\Smalltalk-80.sources')" />
    <Message
      Text="✓ Copied Smalltalk-80.sources to $(DataOutputDir)"
      Importance="high"
      Condition="Exists('$(CompilerOutputDir)Data\Smalltalk-80.sources')" />

    <!-- Copy Smalltalk-80.changes from Compiler output (generated during compilation) -->
    <Copy
      SourceFiles="$(CompilerOutputDir)Data\Smalltalk-80.changes"
      DestinationFolder="$(DataOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(CompilerOutputDir)Data\Smalltalk-80.changes')" />
    <Message
      Text="✓ Copied Smalltalk-80.changes to $(DataOutputDir)"
      Importance="high"
      Condition="Exists('$(CompilerOutputDir)Data\Smalltalk-80.changes')" />
  </Target>


</Project>