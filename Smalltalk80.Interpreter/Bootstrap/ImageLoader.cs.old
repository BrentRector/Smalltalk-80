using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text.Json;
using System.Text.Json.Serialization;
using Smalltalk80.Interpreter.Memory;
using Smalltalk80.Interpreter.ObjectModel;

namespace Smalltalk80.Interpreter.Bootstrap
{
    /// <summary>
    /// Loads Smalltalk classes and methods from JSON manifest files.
    /// Supports multiple JSON formats including bootstrap.json and extended manifests.
    /// </summary>
    public sealed class ImageLoader
    {
        private readonly ObjectMemory memory;
        private readonly ClassBuilder classBuilder;
        private readonly MethodInstaller methodInstaller;
        private readonly ISymbolTable symbolTable;
        private readonly Dictionary<string, BootstrapManifest> loadedManifests = new();
        private readonly JsonSerializerOptions jsonOptions;

        /// <summary>
        /// Initializes a new instance of the ImageLoader class.
        /// </summary>
        /// <param name="memory">The object memory for allocations.</param>
        /// <param name="classBuilder">The class builder for class creation.</param>
        /// <param name="symbolTable">The symbol table for interning.</param>
        /// <param name="getSpecialObject">Optional function to get special objects.</param>
        public ImageLoader(ObjectMemory memory, ClassBuilder classBuilder, ISymbolTable symbolTable, Func<int, OOP>? getSpecialObject = null)
        {
            this.memory = memory ?? throw new ArgumentNullException(nameof(memory));
            this.classBuilder = classBuilder ?? throw new ArgumentNullException(nameof(classBuilder));
            this.symbolTable = symbolTable ?? throw new ArgumentNullException(nameof(symbolTable));
            this.methodInstaller = new MethodInstaller(memory, classBuilder, symbolTable, getSpecialObject);
            
            // Configure JSON options for flexible parsing
            this.jsonOptions = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                ReadCommentHandling = JsonCommentHandling.Skip,
                AllowTrailingCommas = true,
                NumberHandling = JsonNumberHandling.AllowReadingFromString,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            };
        }

        /// <summary>
        /// Loads the bootstrap manifest from a JSON file.
        /// </summary>
        /// <param name="filePath">Path to the bootstrap.json file.</param>
        /// <returns>The loaded bootstrap manifest.</returns>
        public BootstrapManifest LoadBootstrap(string filePath)
        {
            Console.WriteLine($"[ImageLoader] Loading bootstrap from: {filePath}");
            
            if (!File.Exists(filePath))
            {
                throw new FileNotFoundException($"Bootstrap file not found: {filePath}");
            }
            
            var manifest = LoadManifestFromFile(filePath);
            
            Console.WriteLine($"[ImageLoader] Bootstrap loaded: {manifest.Classes.Count} classes");
            
            // Process the bootstrap manifest
            ProcessManifest(manifest, isBootstrap: true);
            
            loadedManifests["bootstrap"] = manifest;
            return manifest;
        }

        /// <summary>
        /// Loads an extended class manifest from a JSON file.
        /// </summary>
        /// <param name="filePath">Path to the extended manifest JSON file.</param>
        /// <returns>The loaded manifest.</returns>
        public BootstrapManifest LoadExtendedManifest(string filePath)
        {
            Console.WriteLine($"[ImageLoader] Loading extended manifest from: {filePath}");
            
            if (!File.Exists(filePath))
            {
                throw new FileNotFoundException($"Extended manifest file not found: {filePath}");
            }
            
            var manifest = LoadManifestFromFile(filePath);
            
            var manifestName = Path.GetFileNameWithoutExtension(filePath);
            Console.WriteLine($"[ImageLoader] Extended manifest '{manifestName}' loaded: {manifest.Classes.Count} classes, {manifest.Methods?.Count ?? 0} methods");
            
            // Process the extended manifest
            ProcessManifest(manifest, isBootstrap: false);
            
            loadedManifests[manifestName] = manifest;
            return manifest;
        }

        /// <summary>
        /// Loads multiple manifest files from a directory.
        /// </summary>
        /// <param name="directoryPath">Path to the directory containing manifest files.</param>
        /// <param name="pattern">File pattern to match (default: "*.json").</param>
        public void LoadManifestsFromDirectory(string directoryPath, string pattern = "*.json")
        {
            Console.WriteLine($"[ImageLoader] Loading manifests from directory: {directoryPath}");
            
            if (!Directory.Exists(directoryPath))
            {
                throw new DirectoryNotFoundException($"Directory not found: {directoryPath}");
            }
            
            var files = Directory.GetFiles(directoryPath, pattern)
                .OrderBy(f => f) // Ensure consistent loading order
                .ToList();
            
            Console.WriteLine($"[ImageLoader] Found {files.Count} manifest files");
            
            foreach (var file in files)
            {
                try
                {
                    // Skip bootstrap.json as it should be loaded separately first
                    if (Path.GetFileName(file).Equals("bootstrap.json", StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }
                    
                    LoadExtendedManifest(file);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[ImageLoader] Error loading manifest {file}: {ex.Message}");
                }
            }
        }

        /// <summary>
        /// Loads and parses a manifest file.
        /// </summary>
        public BootstrapManifest LoadManifestFromFile(string filePath)
        {
            try
            {
                var json = File.ReadAllText(filePath);
                var manifest = JsonSerializer.Deserialize<BootstrapManifest>(json, jsonOptions);
                
                if (manifest == null)
                {
                    throw new InvalidOperationException($"Failed to deserialize manifest from {filePath}");
                }
                
                // Validate and normalize the manifest
                NormalizeManifest(manifest);
                
                return manifest;
            }
            catch (JsonException ex)
            {
                throw new InvalidOperationException($"Invalid JSON in manifest {filePath}: {ex.Message}", ex);
            }
        }

        /// <summary>
        /// Normalizes a manifest to ensure consistent structure.
        /// </summary>
        private void NormalizeManifest(BootstrapManifest manifest)
        {
            // Note: Since we're using init-only properties, we can't modify them after creation.
            // The JSON deserializer should handle default values.
            // We'll just validate that essential fields are present.
            
            foreach (var classDef in manifest.Classes)
            {
                if (classDef.Name == null)
                {
                    throw new InvalidOperationException("Class definition missing required 'name' field");
                }
            }
            
            // Validate methods have required fields
            var allMethods = manifest.Classes
                .SelectMany(c => (c.Methods ?? []).Concat(c.ClassMethods ?? []))
                .Concat(manifest.Methods ?? []);
            
            foreach (var method in allMethods)
            {
                if (method.Selector == null)
                {
                    throw new InvalidOperationException("Method definition missing required 'selector' field");
                }
                if (method.Bytecode == null)
                {
                    throw new InvalidOperationException($"Method '{method.Selector}' missing required 'bytecode' field");
                }
            }
        }

        /// <summary>
        /// Processes only the class creation part of a manifest (no method installation).
        /// </summary>
        public void ProcessClasses(BootstrapManifest manifest)
        {
            Console.WriteLine($"[ImageLoader] Processing classes from manifest");
            ProcessBootstrapClasses(manifest);
            
            // Store the manifest so statistics are tracked
            if (!loadedManifests.ContainsKey("bootstrap"))
            {
                loadedManifests["bootstrap"] = manifest;
            }
        }
        
        /// <summary>
        /// Processes a loaded manifest to create classes and install methods.
        /// </summary>
        private void ProcessManifest(BootstrapManifest manifest, bool isBootstrap)
        {
            Console.WriteLine($"[ImageLoader] Processing manifest (bootstrap: {isBootstrap})");
            
            if (isBootstrap)
            {
                // For bootstrap, create classes through the ClassBuilder phases
                ProcessBootstrapClasses(manifest);
            }
            else
            {
                // For extended manifests, create classes dynamically
                ProcessExtendedClasses(manifest);
            }
            
            // Install all methods
            methodInstaller.InstallMethods(manifest);
            
            // Process any message sends
            if (manifest.Messages != null)
            {
                ProcessMessages(manifest.Messages);
            }
            
            // Process any low-level operations
            if (manifest.Operations != null)
            {
                ProcessOperations(manifest.Operations);
            }
            
            // Note: Initialization expressions are not processed here
            // They should be executed after the bootstrap is complete and the VM is ready
            // The VM should call ExecuteInitializationExpressions after everything is set up
        }

        /// <summary>
        /// Processes bootstrap classes using the ClassBuilder phases.
        /// </summary>
        private void ProcessBootstrapClasses(BootstrapManifest manifest)
        {
            Console.WriteLine("[ImageLoader] Processing bootstrap classes through ClassBuilder phases");
            
            // Convert manifest classes to KernelClass format
            var kernelClasses = manifest.Classes.Select(c => new KernelClass(
                c.Name,
                c.Superclass,
                c.InstanceVariables.ToArray()
            )).ToList();
            
            // Execute ClassBuilder phases
            classBuilder.AllocateStubs(kernelClasses);
            classBuilder.WireClassPointers();
            classBuilder.WireSuperclasses(kernelClasses);
            classBuilder.SetClassNames(symbolTable);
            classBuilder.SetInstanceVariables(kernelClasses, symbolTable);
            
            // Set additional class attributes
            foreach (var classDef in manifest.Classes)
            {
                SetClassAttributes(classDef);
            }
        }

        /// <summary>
        /// Processes extended classes by creating them dynamically.
        /// </summary>
        private void ProcessExtendedClasses(BootstrapManifest manifest)
        {
            Console.WriteLine($"[ImageLoader] Processing {manifest.Classes.Count} extended classes");
            
            foreach (var classDef in manifest.Classes)
            {
                // Check if class already exists
                var existingClass = classBuilder.GetClass(classDef.Name);
                
                if (existingClass.IsNil)
                {
                    // Create new class
                    CreateExtendedClass(classDef);
                }
                else
                {
                    // Update existing class with new attributes
                    UpdateExistingClass(classDef);
                }
            }
        }

        /// <summary>
        /// Creates an extended class dynamically.
        /// </summary>
        private void CreateExtendedClass(ClassDefinition classDef)
        {
            Console.WriteLine($"[ImageLoader] Creating extended class: {classDef.Name}");
            
            // This would typically involve sending messages to create the class
            // For now, we'll use a simplified approach
            
            var classClass = classBuilder.GetClass("Class");
            var metaclassClass = classBuilder.GetClass("Metaclass");
            
            if (classClass.IsNil || metaclassClass.IsNil)
            {
                Console.WriteLine($"[ImageLoader] Warning: Cannot create {classDef.Name}, Class or Metaclass not found");
                return;
            }
            
            // Allocate class and metaclass
            var classOop = memory.AllocateObject(metaclassClass, 8); // Class has 8 fields
            var metaclassOop = memory.AllocateObject(metaclassClass, 6); // Metaclass has 6 fields
            
            // Register with ClassBuilder (would need to extend ClassBuilder API)
            // For now, just log the creation
            Console.WriteLine($"[ImageLoader] Created class {classDef.Name} (simplified creation)");
        }

        /// <summary>
        /// Updates an existing class with new attributes.
        /// </summary>
        private void UpdateExistingClass(ClassDefinition classDef)
        {
            Console.WriteLine($"[ImageLoader] Updating existing class: {classDef.Name}");
            
            // Set any additional attributes not handled during bootstrap
            SetClassAttributes(classDef);
        }

        /// <summary>
        /// Sets additional attributes on a class.
        /// </summary>
        private void SetClassAttributes(ClassDefinition classDef)
        {
            var classOop = classBuilder.GetClass(classDef.Name);
            if (classOop.IsNil) return;
            
            var classObj = memory.GetObject(classOop);
            if (classObj == null) return;
            
            // Set format if specified
            if (classDef.Format != 0)
            {
                classObj.Fields[2] = OOP.FromSmallInteger(classDef.Format); // format field
            }
            
            // Set class variables if any
            if (classDef.ClassVariables.Count > 0)
            {
                SetClassVariables(classOop, classDef.ClassVariables);
            }
            
            // Set pool dictionaries if any
            if (classDef.PoolDictionaries.Count > 0)
            {
                SetPoolDictionaries(classOop, classDef.PoolDictionaries);
            }
        }

        /// <summary>
        /// Sets class variables for a class.
        /// </summary>
        private void SetClassVariables(OOP classOop, List<string> classVariables)
        {
            // Class variables would typically be stored in a dictionary
            // This is a simplified implementation
            Console.WriteLine($"[ImageLoader] Setting {classVariables.Count} class variables");
        }

        /// <summary>
        /// Sets pool dictionaries for a class.
        /// </summary>
        private void SetPoolDictionaries(OOP classOop, List<string> poolDictionaries)
        {
            // Pool dictionaries would be resolved and linked
            // This is a simplified implementation
            Console.WriteLine($"[ImageLoader] Setting {poolDictionaries.Count} pool dictionaries");
        }

        /// <summary>
        /// Processes message send operations.
        /// </summary>
        private void ProcessMessages(List<MessageDefinition> messages)
        {
            Console.WriteLine($"[ImageLoader] Processing {messages.Count} message sends");
            
            foreach (var message in messages)
            {
                Console.WriteLine($"[ImageLoader] Send #{message.Selector} to {message.Receiver}");
                // Message sends would be executed through the VM
                // This requires integration with the execution engine
            }
        }

        /// <summary>
        /// Processes low-level bootstrap operations.
        /// </summary>
        private void ProcessOperations(List<OperationDefinition> operations)
        {
            Console.WriteLine($"[ImageLoader] Processing {operations.Count} operations");
            
            foreach (var op in operations)
            {
                Console.WriteLine($"[ImageLoader] Operation: {op.Op} {op.Name ?? op.Target ?? ""}");
                // Low-level operations would manipulate object memory directly
                // This requires careful implementation to maintain consistency
            }
        }

        /// <summary>
        /// Gets initialization expressions sorted by class hierarchy.
        /// </summary>
        /// <returns>List of initialization expressions sorted with superclasses before subclasses.</returns>
        public List<InitializationExpression> GetSortedInitializationExpressions()
        {
            var allExpressions = new List<InitializationExpression>();
            
            // Collect all initialization expressions from loaded manifests
            foreach (var manifest in loadedManifests.Values)
            {
                if (manifest.InitializationExpressions != null)
                {
                    allExpressions.AddRange(manifest.InitializationExpressions);
                }
            }
            
            // Sort expressions by class hierarchy
            // We need to ensure superclass initializations run before subclass initializations
            return SortByClassHierarchy(allExpressions);
        }
        
        /// <summary>
        /// Sorts initialization expressions by class hierarchy.
        /// </summary>
        private List<InitializationExpression> SortByClassHierarchy(List<InitializationExpression> expressions)
        {
            // Create a dictionary to group expressions by receiver class
            var expressionsByClass = new Dictionary<string, List<InitializationExpression>>();
            
            foreach (var expr in expressions)
            {
                if (!expressionsByClass.ContainsKey(expr.Receiver))
                {
                    expressionsByClass[expr.Receiver] = new List<InitializationExpression>();
                }
                expressionsByClass[expr.Receiver].Add(expr);
            }
            
            // Build class hierarchy levels
            var classLevels = new Dictionary<string, int>();
            
            // First pass: Calculate hierarchy levels for known classes
            foreach (var className in expressionsByClass.Keys)
            {
                classLevels[className] = GetClassHierarchyLevel(className);
            }
            
            // Sort expressions: first by hierarchy level (lower = superclass), then by original order
            var sorted = new List<InitializationExpression>();
            
            // Sort class names by hierarchy level
            var sortedClasses = expressionsByClass.Keys
                .OrderBy(className => classLevels[className])
                .ThenBy(className => className); // Secondary sort by name for stability
            
            // Add expressions in sorted order
            foreach (var className in sortedClasses)
            {
                sorted.AddRange(expressionsByClass[className]);
            }
            
            return sorted;
        }
        
        /// <summary>
        /// Gets the hierarchy level of a class (0 for Object, 1 for direct subclasses, etc.).
        /// </summary>
        private int GetClassHierarchyLevel(string className)
        {
            // Special case for core classes
            if (className == "Object" || className == "nil")
                return 0;
            
            // Look up the class in loaded manifests
            foreach (var manifest in loadedManifests.Values)
            {
                var classDef = manifest.Classes.FirstOrDefault(c => c.Name == className);
                if (classDef != null)
                {
                    // Recursively calculate level based on superclass
                    var superclass = classDef.Superclass ?? "Object";
                    if (superclass == className) // Avoid infinite recursion
                        return 0;
                    return GetClassHierarchyLevel(superclass) + 1;
                }
            }
            
            // If class not found in manifests, check with ClassBuilder
            var classOop = classBuilder.GetClass(className);
            if (!classOop.IsNil)
            {
                // Try to get superclass from the actual class object
                // This would require accessing the class structure
                // For now, return a default level
                return 10; // Assume it's a leaf class
            }
            
            // Unknown class, put at the end
            return 100;
        }
        
        /// <summary>
        /// Gets statistics about loaded manifests.
        /// </summary>
        public LoadStatistics GetStatistics()
        {
            // The actual installed methods are tracked by MethodInstaller
            int totalMethods = methodInstaller.GetAllCachedMethods().Count;
            
            // If no methods were tracked by MethodInstaller, count from manifests
            if (totalMethods == 0)
            {
                foreach (var manifest in loadedManifests.Values)
                {
                    // Count inline methods from class definitions
                    foreach (var classDef in manifest.Classes)
                    {
                        totalMethods += classDef.Methods?.Count ?? 0;
                        totalMethods += classDef.ClassMethods?.Count ?? 0;
                    }
                    
                    // Count flat methods array
                    if (manifest.Methods != null)
                    {
                        totalMethods += manifest.Methods.Count;
                    }
                }
            }
            
            return new LoadStatistics
            {
                ManifestsLoaded = loadedManifests.Count,
                TotalClasses = loadedManifests.Values.Sum(m => m.Classes.Count),
                TotalMethods = totalMethods
            };
        }

        /// <summary>
        /// Statistics about loaded images.
        /// </summary>
        public sealed record LoadStatistics
        {
            /// <summary>
            /// Number of manifests loaded.
            /// </summary>
            public int ManifestsLoaded { get; init; }

            /// <summary>
            /// Total number of classes defined.
            /// </summary>
            public int TotalClasses { get; init; }

            /// <summary>
            /// Total number of methods installed.
            /// </summary>
            public int TotalMethods { get; init; }

            /// <summary>
            /// Returns a string representation of the statistics.
            /// </summary>
            public override string ToString()
            {
                return $"Manifests: {ManifestsLoaded}, Classes: {TotalClasses}, Methods: {TotalMethods}";
            }
        }
    }
}