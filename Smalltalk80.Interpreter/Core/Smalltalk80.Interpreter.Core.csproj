<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Allow test project to access internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="Smalltalk80.Interpreter.Tests" />
  </ItemGroup>
  
  <!-- Shared definitions -->
  <ItemGroup>
    <Compile Include="..\..\Shared\Core\Bytecodes\BytecodeDefinitions.cs"
             Link="Core\Bytecodes\BytecodeDefinitions.cs" />
    <Compile Include="..\..\Shared\Core\FormatWord.cs"
             Link="Core\FormatWord.cs" />
  </ItemGroup>

  <!-- Project references to new HeapManager assemblies -->
  <ItemGroup>
    <ProjectReference Include="..\..\Smalltalk80.Interpreter.Shared.Types\Smalltalk80.Interpreter.Shared.Types.csproj" />
    <ProjectReference Include="..\..\Smalltalk80.Interpreter.HeapManager\Smalltalk80.Interpreter.HeapManager.csproj" />
  </ItemGroup>

  <!-- Temporarily exclude files that still reference old heap manager -->
  <ItemGroup>
    <Compile Remove="VM\ClassPrettyPrinter.cs" />
    <Compile Remove="HeapManager\HeapManagerTests.cs" />
  </ItemGroup>
  
  <!-- Core dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>