<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
  <!-- Shared bytecode definitions -->
  <ItemGroup>
    <Compile Include="..\..\Shared\Core\Bytecodes\BytecodeDefinitions.cs" 
             Link="Core\Bytecodes\BytecodeDefinitions.cs" />
  </ItemGroup>
  
  <!-- Temporarily exclude files that still reference old heap manager -->
  <ItemGroup>
    <Compile Remove="VM\ClassPrettyPrinter.cs" />
    <Compile Remove="HeapManager\HeapManagerTests.cs" />
  </ItemGroup>
  
  <!-- Core dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>