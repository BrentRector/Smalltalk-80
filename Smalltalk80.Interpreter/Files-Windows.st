Path subclass: #WindowsPath	instanceVariableNames: 'driveLetter uncServer uncShare '	classVariableNames: 'Separator '	poolDictionaries: ''	category: 'Files-Windows'!!!WindowsPath methodsFor: 'accessing'!asString    "Answer the path as a string per Microsoft UNC conventions."    | stream |    stream _ WriteStream on: (String new: 100).    self isUNC ifTrue: [        "UNC path: \\server\share\path\..."        stream nextPut: Separator; nextPut: Separator.        stream nextPutAll: uncServer.        stream nextPut: Separator; nextPutAll: uncShare]    ifFalse: [        driveLetter notNil ifTrue: [            stream nextPut: driveLetter; nextPut: $:]].    components do: [:comp |        stream nextPut: Separator; nextPutAll: comp].    stream position = 0 ifTrue: [^'.'].    ^stream contents!!!components    "Answer the path components."    ^components!!!directoryPath    "Answer a new path without the filename."    | newPath |    components size <= 1 ifTrue: [        self isUNC ifTrue: [            ^self class fromString: '\\', uncServer, '\', uncShare].        ^self class fromString: (driveLetter ifNil: [''] ifNotNil: [driveLetter asString, ':'])].    newPath _ self class new.    newPath setDriveLetter: driveLetter uncServer: uncServer uncShare: uncShare components: components allButLast.    ^newPath!!!driveLetter    "Answer the drive letter or nil."    ^driveLetter!!!extension    "Answer the file extension or empty string."    | name dotIndex |    name _ self fileName.    dotIndex _ name findLast: [:c | c = $.].    dotIndex = 0 ifTrue: [^''].    ^name copyFrom: dotIndex + 1 to: name size!!!fileName    "Answer the last component (filename)."    components isEmpty ifTrue: [^''].    ^components last!!!uncServer    "Answer the UNC server name or nil."    ^uncServer!!!uncShare    "Answer the UNC share name or nil."    ^uncShare!!! !!WindowsPath methodsFor: 'conversion'!canonicalize    "Answer a new WindowsPath in canonical Windows form.     Canonical form:     - Uses backslash separator (already normalized during parsing)     - Resolves . (current directory) components by removing them     - Resolves .. (parent directory) components by removing parent     - Drive letter is uppercased     - UNC server and share names are preserved as-is (case-preserving)"    | newComponents result |    newComponents _ OrderedCollection new.    "Process each component, resolving . and .."    components do: [:comp |        comp = '.'            ifTrue: ["Skip current directory reference"]            ifFalse: [                comp = '..'                    ifTrue: [                        "Go up one level if possible"                        newComponents isEmpty                            ifFalse: [newComponents removeLast]]                    ifFalse: [newComponents add: comp]]].    result _ self class new.    result setDriveLetter: (driveLetter ifNotNil: [driveLetter asUppercase])           uncServer: uncServer           uncShare: uncShare           components: newComponents asArray.    ^result!!!canonicalString    "Answer the path as a canonical string.     Convenience method combining canonicalize and asString."    ^self canonicalize asString!!! !!WindowsPath methodsFor: 'initialization'!initializeFromString: aString    "Parse a Windows path string per Microsoft UNC conventions.     Windows accepts both backslash and forward slash as separators.     UNC format: \\server\share\path\to\file"    | parts startIndex normalized |    uncServer _ nil.    uncShare _ nil.    aString isEmpty ifTrue: [        driveLetter _ nil.        components _ #().        ^self].    "Normalize forward slashes to backslashes for consistent parsing"    normalized _ aString copyReplaceAll: '/' with: '\'.    "Check for drive letter (C:)"    (normalized size >= 2 and: [(normalized at: 2) = $:]) ifTrue: [        driveLetter _ normalized at: 1.        startIndex _ 3.        "Skip leading separator after drive"        (normalized size >= 3 and: [(self class isSeparator: (normalized at: 3))])            ifTrue: [startIndex _ 4]]    ifFalse: [        "Check for UNC path (\\server\share)"        (normalized size >= 2 and: [(self class isSeparator: (normalized at: 1))            and: [(self class isSeparator: (normalized at: 2))]])            ifTrue: [                "Parse UNC: \\server\share\rest"                driveLetter _ nil.                parts _ (normalized copyFrom: 3 to: normalized size)                    findTokens: (String with: Separator).                parts _ parts select: [:p | p notEmpty].                parts size >= 1 ifTrue: [uncServer _ parts first].                parts size >= 2 ifTrue: [uncShare _ parts second].                "Components are everything after server\share"                parts size > 2                    ifTrue: [components _ parts copyFrom: 3 to: parts size]                    ifFalse: [components _ #()].                ^self]            ifFalse: [                driveLetter _ nil.                startIndex _ 1.                "Skip leading separator for absolute paths"                (self class isSeparator: (normalized at: 1)) ifTrue: [startIndex _ 2]]].    "Parse remaining components - split on backslash"    startIndex > normalized size        ifTrue: [components _ #()]        ifFalse: [            parts _ (normalized copyFrom: startIndex to: normalized size)                findTokens: (String with: Separator).            components _ parts select: [:p | p notEmpty]].    ^self!!! !!WindowsPath methodsFor: 'operations'!/ aString    "Answer a new path with aString appended as a component."    | newPath newComponents |    newComponents _ components copyWith: aString.    newPath _ self class new.    newPath setDriveLetter: driveLetter uncServer: uncServer uncShare: uncShare components: newComponents.    ^newPath!!!withExtension: extString    "Answer a new path with the given extension."    | baseName newName |    components isEmpty ifTrue: [^self].    baseName _ self fileName.    (baseName includes: $.)        ifTrue: [baseName _ baseName copyFrom: 1 to: (baseName findLast: [:c | c = $.]) - 1].    newName _ baseName, '.', extString.    ^self directoryPath / newName!!! !!WindowsPath methodsFor: 'printing'!printOn: aStream    aStream nextPutAll: self asString!!! !!WindowsPath methodsFor: 'private'!setDriveLetter: drive components: comps    "Set drive letter and components (for backward compatibility)."    driveLetter _ drive.    uncServer _ nil.    uncShare _ nil.    components _ comps.    ^self!!!setDriveLetter: drive uncServer: server uncShare: share components: comps    "Set all path components including UNC server and share."    driveLetter _ drive.    uncServer _ server.    uncShare _ share.    components _ comps.    ^self!!! !!WindowsPath methodsFor: 'testing'!isAbsolute    "Answer whether this is an absolute path.     Both drive paths (C:\) and UNC paths (\\server\share) are absolute."    ^driveLetter notNil or: [self isUNC]!!!isEmpty    "Answer whether this path is empty."    ^driveLetter isNil and: [uncServer isNil and: [components isEmpty]]!!!isRelative    "Answer whether this is a relative path."    ^self isAbsolute not!!!isRoot    "Answer whether this path represents a root directory.     For drive paths: C:\ is root. For UNC paths: \\server\share is root."    ^components isEmpty and: [self isAbsolute]!!!isUNC    "Answer whether this is a UNC path (\\server\share)."    ^uncServer notNil and: [uncShare notNil]!!! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WindowsPath class
	instanceVariableNames: ''!!WindowsPath class methodsFor: 'class initialization'!initialize    "Initialize the path separator."    Separator _ $\.    ^self!!! !!WindowsPath class methodsFor: 'instance creation'!fromString: aString    "Parse a path string into a WindowsPath."    ^self new initializeFromString: aString!!!isSeparator: aCharacter    "Answer whether aCharacter is a path separator.     Windows accepts both backslash and forward slash."    ^aCharacter = $\ or: [aCharacter = $/]!!!separator    "Answer the path separator character."    ^Separator!!! !WindowsPath initialize!FileSystem subclass: #WindowsFileSystem	instanceVariableNames: ''	classVariableNames: 'Default '	poolDictionaries: ''	category: 'Files-Windows'!!!WindowsFileSystem methodsFor: 'concrete class factories'!directoryClass	"Answer WindowsDirectory"	^WindowsDirectory!!!fileClass	"Answer WindowsFile"	^WindowsFile!!!pathClass	"Answer WindowsPath"	^WindowsPath!!!streamClass	"Answer WindowsFileStream"	^WindowsFileStream!!! !!WindowsFileSystem methodsFor: 'directory access'!currentDirectory	"Answer the current working directory"	^WindowsDirectory on: '.'!!!primGetTempDirectory	"Answer temp directory path"	<primitive: 150>	^'C:\Temp'!!!rootDirectory	"Answer the root directory of the default volume (C:\)"	^WindowsDirectory on: 'C:\'!!!temporaryDirectory	"Answer the system temporary directory"	^WindowsDirectory on: (self primGetTempDirectory)!!! !!WindowsFileSystem methodsFor: 'link creation'!createHardLink: linkPath toFile: existingPath	"Create a hard link. Both paths must be on same NTFS volume.	 Hard links are only supported for files, not directories."	^self primCreateHardLink: linkPath existing: existingPath!!!createJunction: junctionPath toDirectory: targetPath	"Create a junction point (directory soft link).	 Junctions can span local volumes but not network paths.	 Target path must be absolute."	(self isAbsolutePath: targetPath) ifFalse: [		self error: 'Junction target must be an absolute path'].	^self primCreateJunction: junctionPath target: targetPath!!!createSymbolicLink: linkPath toTarget: targetPath asDirectory: isDirectory	"Create a symbolic link using Windows API.	 Requires SeCreateSymbolicLinkPrivilege or Developer Mode (Win10 1607+).	 isDirectory must be true if target is a directory."	^self primCreateSymbolicLink: linkPath target: targetPath isDirectory: isDirectory!!! !!WindowsFileSystem methodsFor: 'link primitives'!primCreateHardLink: linkPath existing: existingPath	"Primitive to create hard link. Uses CreateHardLinkW."	<primitive: 231>	self primitiveFailed!!!primCreateJunction: junctionPath target: targetPath	"Primitive to create junction. Uses DeviceIoControl with FSCTL_SET_REPARSE_POINT."	<primitive: 232>	self primitiveFailed!!!primCreateSymbolicLink: linkPath target: targetPath isDirectory: isDirectory	"Primitive to create symbolic link. Uses CreateSymbolicLinkW.	 Flags: SYMBOLIC_LINK_FLAG_DIRECTORY (0x1) if isDirectory.	 May also use SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE (0x2)."	<primitive: 230>	self primitiveFailed!!!primDeleteReparsePoint: aPathString	"Primitive to delete a reparse point (junction or symlink).	 Uses DeviceIoControl with FSCTL_DELETE_REPARSE_POINT."	<primitive: 239>	self primitiveFailed!!!primGetFileAttributes: aPathString	"Primitive to get file attributes. Uses GetFileAttributesW.	 Returns nil if file doesn't exist."	<primitive: 233>	^nil!!!primGetFinalPath: aPathString	"Primitive to get final path, resolving all links.	 Uses GetFinalPathNameByHandleW."	<primitive: 237>	^nil!!!primGetHardLinkCount: aPathString	"Primitive to get hard link count.	 Uses GetFileInformationByHandle."	<primitive: 238>	^1!!!primGetJunctionTarget: aPathString	"Primitive to read junction target."	<primitive: 236>	^nil!!!primGetReparseTag: aPathString	"Primitive to get reparse point tag. Uses FindFirstFileW or DeviceIoControl."	<primitive: 234>	^0!!!primGetSymbolicLinkTarget: aPathString	"Primitive to read symbolic link target."	<primitive: 235>	^nil!!! !!WindowsFileSystem methodsFor: 'link queries'!hardLinkCountOf: aPathString	"Answer the number of hard links to the file"	^self primGetHardLinkCount: aPathString!!!isJunction: aPathString	"Answer whether path is a junction point"	| attrs tag |	attrs _ self primGetFileAttributes: aPathString.	attrs isNil ifTrue: [^false].	"Check for reparse point attribute (0x400) and directory (0x10)"	((attrs bitAnd: 16r400) = 0 or: [(attrs bitAnd: 16r10) = 0]) ifTrue: [^false].	"Get reparse tag to distinguish junction from symlink"	tag _ self primGetReparseTag: aPathString.	^tag = 16rA0000003 "IO_REPARSE_TAG_MOUNT_POINT"!!!isSymbolicLink: aPathString	"Answer whether path is a symbolic link (not a junction)"	| attrs tag |	attrs _ self primGetFileAttributes: aPathString.	attrs isNil ifTrue: [^false].	"Check for reparse point attribute (0x400)"	(attrs bitAnd: 16r400) = 0 ifTrue: [^false].	"Get reparse tag to distinguish symlink from junction"	tag _ self primGetReparseTag: aPathString.	^tag = 16rA000000C "IO_REPARSE_TAG_SYMLINK"!!!linkTargetOf: aPathString	"Answer the immediate target path of a link, or nil if not a link"	(self isSymbolicLink: aPathString) ifTrue: [		^self primGetSymbolicLinkTarget: aPathString].	(self isJunction: aPathString) ifTrue: [		^self primGetJunctionTarget: aPathString].	^nil!!!resolvedTargetOf: aPathString	"Answer the final resolved target path, following all links.	 Uses Windows GetFinalPathNameByHandle for reliable resolution."	^self primGetFinalPath: aPathString!!! !!WindowsFileSystem methodsFor: 'link support'!supportsHardLinks	"NTFS supports hard links for files"	^true!!!supportsJunctions	"NTFS supports directory junctions"	^true!!!supportsSymbolicLinks	"Windows Vista+ supports symbolic links"	^true!!!symbolicLinkClass	"Answer the concrete SymbolicLink class"	^WindowsSymbolicLink!!! !!WindowsFileSystem methodsFor: 'name constraints'!illegalCharacters	"Characters not allowed in Windows file names"	^#($\ $/ $: $* $? $" $< $> $|)!!!isValidFileName: aName	"Windows-specific validation including reserved names, trailing dots/spaces,	 and control characters (ASCII 0-31) per Microsoft documentation."	| baseName |	(super isValidFileName: aName) ifFalse: [^false].	"Windows doesn't allow control characters (ASCII 0-31)"	aName do: [:ch | ch asciiValue < 32 ifTrue: [^false]].	"Windows doesn't allow trailing dots or spaces"	(aName last = $. or: [aName last = $ ]) ifTrue: [^false].	"Check base name without extension against reserved names"	baseName _ (aName includes: $.)		ifTrue: [aName copyFrom: 1 to: (aName indexOf: $.) - 1]		ifFalse: [aName].	self reservedNames do: [:reserved |		(baseName sameAs: reserved) ifTrue: [^false]].	^true!!!maxFileNameLength	"NTFS maximum file name length"	^255!!!reservedNames	"Windows reserved device names - cannot be used as file names"	^#('CON' 'PRN' 'AUX' 'NUL'	   'COM1' 'COM2' 'COM3' 'COM4' 'COM5' 'COM6' 'COM7' 'COM8' 'COM9'	   'LPT1' 'LPT2' 'LPT3' 'LPT4' 'LPT5' 'LPT6' 'LPT7' 'LPT8' 'LPT9')!!! !!WindowsFileSystem methodsFor: 'naming semantics'!isCasePreserving	"Windows preserves case"	^true!!!isCaseSensitive	"Windows is case-insensitive"	^false!!! !!WindowsFileSystem methodsFor: 'path characteristics'!isAbsolutePath: aString	"Test for absolute path (C:\ or \\server\share)"	aString isEmpty ifTrue: [^false].	"UNC path"	(aString beginsWith: '\\') ifTrue: [^true].	"Drive letter path"	(aString size >= 3 and: [		(aString at: 2) = $: and: [			(aString at: 3) = $\ or: [(aString at: 3) = $/]]]) ifTrue: [^true].	^false!!!pathSeparator	"Primary path separator is backslash"	^$\!!! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WindowsFileSystem class
	instanceVariableNames: ''!!WindowsFileSystem class methodsFor: 'class initialization'!initialize	"Initialize class variables and install Disk global"	"WindowsFileSystem initialize"	Default _ self new.	Smalltalk at: #Disk put: Default!!! !!WindowsFileSystem class methodsFor: 'instance access'!default	"Answer the singleton instance"	Default isNil ifTrue: [Default _ self new].	^Default!!! !WindowsFileSystem initialize!Directory subclass: #WindowsDirectory	instanceVariableNames: ''	classVariableNames: 'ExternalReferences Separator '	poolDictionaries: ''	category: 'Files-Windows'!!!WindowsDirectory methodsFor: 'accessing'!directoryName    "Return directory name"    ^pathName!!!fullName    "Return full directory path"    ^pathName!!!fullNameFor: fileName    "Build full path for file in this directory"    pathName = '.' ifTrue: [^fileName].    ^pathName, (String with: Separator), fileName!!!pathName    "Return the directory path"    ^pathName!!!versionNumbers    "Answer whether version numbers are supported (no)"    ^false!!! !!WindowsDirectory methodsFor: 'directory operations'!close    "No-op for compatibility"    ^self!!!create    "Create the directory"    <primitive: 127>    self error: 'Cannot create directory: ', pathName!!!flush    "No-op for compatibility"    ^self!!!open    "No-op for compatibility"    ^self!!!release    "No-op for compatibility"    ^self!!! !!WindowsDirectory methodsFor: 'enumerating'!directoryNames    "Return subdirectory names"    ^self entries select: [:name | name endsWith: (String with: Separator)]!!!do: aBlock    "Iterate over files in directory"    self fileNames do: [:name |        aBlock value: (self fileNamed: name)]!!!entries    "Return all directory entries"    <primitive: 146>    ^self primLookup: pathName pattern: '*'!!!fileNames    "Return file names in directory"    ^self entries select: [:name | (name endsWith: (String with: Separator)) not]!!!next    "Return next file (compatibility - use do: instead)"    ^nil!!!reset    "Reset enumeration (compatibility)"    ^self!!! !!WindowsDirectory methodsFor: 'file access'!directoryNamed: dirName    "Return WindowsDirectory for named subdirectory"    ^WindowsDirectory on: (self fullNameFor: dirName)!!!fileClass    "Answer the file class for this directory"    ^WindowsFile!!!fileNamed: fileName    "Return WindowsFile for named file"    ^WindowsFile on: (self fullNameFor: fileName)!!! !!WindowsDirectory methodsFor: 'file copying'!primCopyFile: srcPath to: destPath    "Platform primitive for file copy. Falls back to stream copy if primitive fails."    <primitive: 157>    | f1 f2 |    "Fallback: character-by-character stream copy"    f1 _ (Disk fileAt: srcPath) readStream.    f2 _ (Disk fileAt: destPath) writeStream.    [f1 atEnd] whileFalse: [f2 nextPut: f1 next].    f2 close.    f1 close!!!retrieve: aFileName    "Copy file to itself (no-op)"    ^self!!!retrieveFrom: aFileName1 copyTo: aFileName2    "Copy from one file to another. Uses platform primitive when available,     falls back to stream copying when primitive fails."    | srcPath destPath |    srcPath _ self fullNameFor: aFileName1.    destPath _ self fullNameFor: aFileName2.    ^self primCopyFile: srcPath to: destPath!!!store: aFileName    "Store file (no-op)"    ^self!!!storeFrom: aFileName1 copyTo: aFileName2    "Store from one file to another"    ^self retrieveFrom: aFileName1 copyTo: aFileName2!!! !!WindowsDirectory methodsFor: 'file management'!filesMatching: pattern    "Answer files matching pattern"    ^self fileNames select: [:name | pattern match: name]!!!rename: aFile newName: newFileName    "Rename file in directory"    | oldPath newPath |    oldPath _ self fullNameFor: aFile fileName.    newPath _ self fullNameFor: newFileName.    self primRename: oldPath to: newPath.    aFile initPathName: newPath.    ^aFile!!! !!WindowsDirectory methodsFor: 'file operations'!add: aFile    "Add file to directory (touch to create)"    | stream |    stream _ WindowsFileStream writeOn: (self fullNameFor: aFile fileName).    stream close.    ^aFile!!!addKey: fileName    "Create new file, return WindowsFile"    | file stream |    file _ self fileNamed: fileName.    "Touch file to create it"    stream _ WindowsFileStream writeOn: (self fullNameFor: fileName).    stream close.    ^file!!!addNew: aFile    "Add new file"    ^self add: aFile!!!file: fileName    "Return read/write stream for file"    ^WindowsFileStream readWriteOn: (self fullNameFor: fileName)!!!findKey: fileName    "Find existing file, error if not found"    (self includesKey: fileName) ifFalse: [        self error: 'file not found: ', fileName].    ^self fileNamed: fileName!!!findOrAddKey: fileName    "Find or create file"    ^self fileNamed: fileName!!!newFile: fileName    "Return write stream for new file"    ^WindowsFileStream writeOn: (self fullNameFor: fileName)!!!oldFile: fileName    "Return read stream for existing file"    ^WindowsFileStream readOn: (self fullNameFor: fileName)!!!remove: aFile    "Remove file from directory"    aFile delete.    ^aFile!!!removeKey: fileName    "Remove file by name"    ^self remove: (self fileNamed: fileName)!!! !!WindowsDirectory methodsFor: 'initialization'!initPathName: aString    pathName _ aString!!! !!WindowsDirectory methodsFor: 'primitives'!primLookup: path pattern: pattern    <primitive: 146>    ^#()!!!primRename: oldPath to: newPath    <primitive: 126>    self error: 'Cannot rename'!!! !!WindowsDirectory methodsFor: 'printing'!listFilesOn: aStream    "Write file names to stream"    self fileNames do: [:name |        aStream cr; nextPutAll: name]!!!printOn: aStream    aStream nextPutAll: 'a WindowsDirectory on '.    pathName printOn: aStream!!! !!WindowsDirectory methodsFor: 'private'!find: aFile    "Find file or nil"    aFile exists ifTrue: [^aFile].    ^nil!!!find: aFile ifAbsentDo: aBlock    "Find file or evaluate block"    aFile exists ifTrue: [^aFile].    ^aBlock value: aFile!!!initFile: aFile    "Initialize file"    ^aFile!!!initFileName: aFileName    "Create and initialize file with name"    ^self fileNamed: aFileName!!! !!WindowsDirectory methodsFor: 'testing'!includes: aFile    "Test if file exists in directory"    ^aFile exists!!!includesKey: fileName    "Test if named file exists"    ^(WindowsFile on: (self fullNameFor: fileName)) exists!!! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WindowsDirectory class
	instanceVariableNames: ''!!WindowsDirectory class methodsFor: 'class initialization'!initialize    "Initialize class variables"    Separator _ $\.    ExternalReferences _ OrderedCollection new!!! !!WindowsDirectory class methodsFor: 'external references'!addExternalReference: anObject    "Track external file reference"    (ExternalReferences includes: anObject) ifFalse: [        ExternalReferences add: anObject]!!!initializeExternalReferences    "Initialize external references"    ExternalReferences _ OrderedCollection new!!!releaseExternalReferences    "Release all external references"    ExternalReferences isNil ifTrue: [^self].    [ExternalReferences isEmpty] whileFalse: [        ExternalReferences removeLast release]!!!removeExternalReference: anObject    "Remove external file reference"    ExternalReferences remove: anObject ifAbsent: []!!! !!WindowsDirectory class methodsFor: 'instance creation'!current    "Return current directory"    ^self on: '.'!!!default    "Return default directory"    ^self current!!!on: aPathString    "Create directory reference"    ^self new initPathName: aPathString!!! !!WindowsDirectory class methodsFor: 'path parsing'!directoryFromName: fileDesignator setFileName: localNameBlock    "Parse path into directory and filename, call block with filename.     This is used by FileStream class methods."    | lastSep dirPath fileName |    lastSep _ fileDesignator findLast: [:c | c = Separator or: [c = $/]].    lastSep = 0        ifTrue: [            dirPath _ '.'.            fileName _ fileDesignator]        ifFalse: [            dirPath _ fileDesignator copyFrom: 1 to: lastSep - 1.            fileName _ fileDesignator copyFrom: lastSep + 1 to: fileDesignator size].    localNameBlock value: fileName.    ^self on: dirPath!!!pathSeparator    "Answer the path separator character"    ^Separator!!! !WindowsDirectory initialize!File subclass: #WindowsFile	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Files-Windows'!!!WindowsFile methodsFor: 'accessing'!directory    "Return Directory for parent"    ^self fileSystem directoryAt: self path directoryPath asString!!!fileName    "Extract just the filename using Path"    ^self path fileName!!!fullName    "Return full path"    ^pathName!!!path    "Answer a Path object for this file"    ^self fileSystem pathFromString: pathName!!!pathName    "Return the file path"    ^pathName!!! !!WindowsFile methodsFor: 'initialization'!initPathName: aString    pathName _ aString!!! !!WindowsFile methodsFor: 'operations'!beSnapshotFile    "Mark as snapshot file for VM primitive 97.     Just needs to register the filename - no file I/O needed."    <primitive: 156>    ^self!!!delete    "Delete the file"    <primitive: 125>    self error: 'Cannot delete file'!!!renameTo: newPathString    "Rename file to new path"    self primRename: pathName to: newPathString.    pathName _ newPathString!!! !!WindowsFile methodsFor: 'primitives'!primGetAttributes: path    <primitive: 154>    ^nil!!!primRename: oldPath to: newPath    <primitive: 126>    self error: 'Cannot rename file'!!! !!WindowsFile methodsFor: 'streaming'!appendStream    "Open for appending"    ^WindowsFileStream appendOn: pathName!!!asFileStream    "Return read/write stream for compatibility"    ^self readWriteStream!!!readStream    "Open for reading"    ^WindowsFileStream readOn: pathName!!!readWriteStream    "Open for read/write"    ^WindowsFileStream readWriteOn: pathName!!!writeStream    "Open for writing"    ^WindowsFileStream writeOn: pathName!!! !!WindowsFile methodsFor: 'testing'!exists    "Test if file exists"    ^(self primGetAttributes: pathName) notNil!!!size    "Return file size"    | attrs |    attrs _ self primGetAttributes: pathName.    attrs isNil ifTrue: [^0].    ^attrs at: 1!!! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WindowsFile class
