th specified mode"    | accessMode shareMode createMode |    mode _ modeValue.    "Map mode to Windows file access flags"    modeValue = ReadMode ifTrue: [        accessMode _ 1.  "GENERIC_READ"        shareMode _ 1.   "FILE_SHARE_READ"        createMode _ 3]. "OPEN_EXISTING"    modeValue = WriteMode ifTrue: [        accessMode _ 2.  "GENERIC_WRITE"        shareMode _ 0.   "No sharing"        createMode _ 2]. "CREATE_ALWAYS"    modeValue = AppendMode ifTrue: [        accessMode _ 2.  "GENERIC_WRITE"        shareMode _ 0.   "No sharing"        createMode _ 4]. "OPEN_ALWAYS"    modeValue = ReadWriteMode ifTrue: [        accessMode _ 3.  "GENERIC_READ | GENERIC_WRITE"        shareMode _ 0.   "No sharing"        createMode _ 4]. "OPEN_ALWAYS"    handle _ self primOpen: pathName                  accessMode: accessMode                  shareMode: shareMode                  createMode: createMode.    handle isNil ifTrue: [self error: 'Cannot open file: ', pathName].    handle < 0 ifTrue: [self error: 'Cannot open file: ', pathName].    closed _ false.    position _ 0.    modeValue = AppendMode ifTrue: [self setToEnd]!!! !!WindowsFileStream methodsFor: 'reading'!contentsOfEntireFile    "Read entire file and close"    | contents |    self reset.    self readOnly.    contents _ self next: self size.    self close.    ^contents!!!next    "Read and return next character"    | byte |    closed ifTrue: [self reopen].    self atEnd ifTrue: [^nil].    byte _ self primReadByte: handle at: position.    byte < 0 ifTrue: [^nil].    position _ position + 1.    ^Character value: byte!!!next: count    "Read count characters into a String"    | string index char |    string _ String new: count.    index _ 1.    [index <= count] whileTrue: [        char _ self next.        char isNil ifTrue: [^string copyFrom: 1 to: index - 1].        string at: index put: char.        index _ index + 1].    ^string!!!nextChunk    "Read chunk terminated by !! (for source files).     Doubled !!!! are converted to single !!"    | result char prevWasBang |    result _ WriteStream on: (String new: 1000).    prevWasBang _ false.    [self atEnd] whileFalse: [        char _ self next.        char isNil ifTrue: [^result contents].        char == $!!            ifTrue: [                prevWasBang                    ifTrue: [                        result nextPut: $!!.                        prevWasBang _ false]                    ifFalse: [prevWasBang _ true]]            ifFalse: [                prevWasBang ifTrue: [^result contents].                result nextPut: char]].    ^result contents!!!nextWord    "Answer the next two bytes from the receiver as an Integer (big-endian)."    | high low |    high _ self next.    high == nil ifTrue: [^false].    low _ self next.    low == nil ifTrue: [^false].    ^(high asInteger bitShift: 8) + low asInteger!!!peek    "Read next character without advancing position"    | char savedPos |    savedPos _ position.    char _ self next.    position _ savedPos.    ^char!!! !!WindowsFileStream methodsFor: 'snapshot'!beSnapshotFile    "Mark as snapshot file for VM primitive 97"    <primitive: 156>    ^self!!! !!WindowsFileStream methodsFor: 'writing'!cr    "Write carriage return"    self nextPut: Character cr!!!flush    "No-op for direct file access"    ^self!!!nextChunkPut: aString    "Write chunk with !! terminator.     Single !! in aString are doubled to !!!!"    aString do: [:char |        char == $!! ifTrue: [self nextPut: $!!].        self nextPut: char].    self nextPut: $!!.    self cr.    ^aString!!!nextPut: aCharacter    "Write a character"    | byte |    closed ifTrue: [self reopen].    byte _ aCharacter asciiValue.    self primWriteByte: handle at: position value: byte.    position _ position + 1.    ^aCharacter!!!nextPutAll: aCollection    "Write all characters from collection"    aCollection do: [:each |        (each isKindOf: Character)            ifTrue: [self nextPut: each]            ifFalse: [self nextPut: (Character value: each)]].    ^aCollection!!!nextWordPut: aWord    "Append to the receiver an Integer as the next two bytes (big-endian)."    self nextPut: (Character value: ((aWord bitShift: -8) bitAnd: 255)).    self nextPut: (Character value: (aWord bitAnd: 255)).    ^aWord!!!shorten    "Truncate file at current position"    closed ifTrue: [^self].    self primTruncate: handle!!! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WindowsFileStream class
