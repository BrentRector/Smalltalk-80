namespace Smalltalk80.Interpreter.ColdStart.MethodInstallers;

using Smalltalk80.Interpreter.Core.Objects;
using Smalltalk80.Interpreter.Core.Values;

/// <summary>
/// Installs kernel methods for process-related classes including Process, 
/// ProcessorScheduler, Semaphore, LinkedList, and Link.
/// </summary>
public static class ProcessMethodsInstaller
{
    /// <summary>
    /// Installs all process-related methods.
    /// </summary>
    public static void Install()
    {
        InstallProcessMethods();
        InstallProcessorSchedulerMethods();
        InstallSemaphoreMethods();
        InstallLinkedListMethods();
        InstallLinkMethods();
    }
    
    /// <summary>
    /// Installs Process methods.
    /// </summary>
    private static void InstallProcessMethods()
    {
        var processClass = SystemDictionary.ProcessClass;
        if (processClass == null) return;
        
        var instanceMethodCount = 0;
        
        if (Program.RuntimeOptions?.EnableColdStartLogging ?? false)
        {
            Console.WriteLine("[COLD START] Installing Process instance methods: #resume, #suspend, #terminate, #priority, #priority:, #suspendedContext, #suspendedContext:, #offList");
        }
        
        // resume - primitive 87
        processClass.AddMethod("resume", SCompiledMethod.CreateCompiledMethod(
            "resume",
            [], // No fallback needed - primitive 87 cannot fail
            new SArray(),
            0, 0, 87));
        instanceMethodCount++;
        
        // suspend - primitive 88
        processClass.AddMethod("suspend", SCompiledMethod.CreateCompiledMethod(
            "suspend",
            [], // No fallback needed - primitive 88 cannot fail
            new SArray(),
            0, 0, 88));
        instanceMethodCount++;
        
        // terminate - primitive 91
        processClass.AddMethod("terminate", SCompiledMethod.CreateCompiledMethod(
            "terminate",
            [], // No fallback needed - primitive 91 cannot fail
            new SArray(),
            0, 0, 91));
        instanceMethodCount++;
        
        // priority
        // ^priority
        processClass.AddMethod("priority", SCompiledMethod.CreateCompiledMethod(
            "priority",
            [0x01, 0x7C], // Push priority instance var (index 1), return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // priority: anInteger
        // priority := anInteger
        processClass.AddMethod("priority:", SCompiledMethod.CreateCompiledMethod(
            "priority:",
            [0x10, 0x61, 0x70, 0x7C], // Push arg, store in priority (index 1), push self, return
            new SArray(),
            1, 0));
        instanceMethodCount++;
        
        // suspendedContext
        // ^suspendedContext
        processClass.AddMethod("suspendedContext", SCompiledMethod.CreateCompiledMethod(
            "suspendedContext",
            [0x00, 0x7C], // Push suspendedContext instance var (index 0), return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // suspendedContext: aContext (private)
        // suspendedContext := aContext
        processClass.AddMethod("suspendedContext:", SCompiledMethod.CreateCompiledMethod(
            "suspendedContext:",
            [0x10, 0x60, 0x70, 0x7C], // Push arg, store in suspendedContext (index 0), push self, return
            new SArray(),
            1, 0));
        instanceMethodCount++;
        
        // offList
        // myList := nil
        processClass.AddMethod("offList", SCompiledMethod.CreateCompiledMethod(
            "offList",
            [0x71, 0x62, 0x70, 0x7C], // Push nil, store in myList (index 2), push self, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        if (Program.RuntimeOptions?.EnableColdStartLogging ?? false)
        {
            Console.WriteLine($"[COLD START] Process: {instanceMethodCount} instance methods installed");
        }
    }
    
    /// <summary>
    /// Installs ProcessorScheduler methods.
    /// </summary>
    private static void InstallProcessorSchedulerMethods()
    {
        var processorSchedulerClass = SystemDictionary.ProcessorSchedulerClass;
        if (processorSchedulerClass == null) return;
        
        var instanceMethodCount = 0;
        
        if (Program.RuntimeOptions?.EnableColdStartLogging ?? false)
        {
            Console.WriteLine("[COLD START] Installing ProcessorScheduler instance methods");
        }
        
        // activeProcess
        // ^activeProcess
        processorSchedulerClass.AddMethod("activeProcess", SCompiledMethod.CreateCompiledMethod(
            "activeProcess",
            [0x01, 0x7C], // Push activeProcess instance var, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // activePriority  
        // ^activeProcess priority
        var activePriorityLiterals = SArray.From(SSymbol.Intern("priority"));
        processorSchedulerClass.AddMethod("activePriority", SCompiledMethod.CreateCompiledMethod(
            "activePriority",
            [0x01, 0xD0, 0x7C], // Push activeProcess, send priority, return
            activePriorityLiterals,
            0, 0));
        instanceMethodCount++;
        
        // highestPriority
        // ^quiescentProcessLists size
        var highestPriorityLiterals = SArray.From(SSymbol.Intern("size"));
        processorSchedulerClass.AddMethod("highestPriority", SCompiledMethod.CreateCompiledMethod(
            "highestPriority",
            [0x00, 0xD0, 0x7C], // Push quiescentProcessLists, send size, return
            highestPriorityLiterals,
            0, 0));
        instanceMethodCount++;
        
        // yield
        // | semaphore |
        // semaphore := Semaphore new.
        // [semaphore signal] fork.
        // semaphore wait
        var yieldLiterals = SArray.From(
            SSymbol.Intern("Semaphore"),
            SSymbol.Intern("new"),
            SSymbol.Intern("signal"),
            SSymbol.Intern("fork"),
            SSymbol.Intern("wait"));
        processorSchedulerClass.AddMethod("yield", SCompiledMethod.CreateCompiledMethod(
            "yield",
            [0x40, 0xD1, 0x68,      // Push Semaphore, send new, store temp
             0x89, 0x11, 0xD2, 0x7D, // Push block [semaphore signal]
             0xC8, 0xD3,            // Send fork
             0x87,                  // Pop
             0x11, 0xD4, 0x7C],     // Push temp, send wait, return
            yieldLiterals,
            0, 1));  // 0 args, 1 temp
        instanceMethodCount++;
        
        // terminateActive
        // activeProcess terminate
        var terminateActiveLiterals = SArray.From(SSymbol.Intern("terminate"));
        processorSchedulerClass.AddMethod("terminateActive", SCompiledMethod.CreateCompiledMethod(
            "terminateActive",
            [0x01, 0xD0, 0x7C], // Push activeProcess, send terminate, return
            terminateActiveLiterals,
            0, 0));
        instanceMethodCount++;
        
        // Priority name methods - return constants
        // highIOPriority - returns 7
        processorSchedulerClass.AddMethod("highIOPriority", SCompiledMethod.CreateCompiledMethod(
            "highIOPriority",
            [0x77, 0x7C], // Push 7, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // lowIOPriority - returns 6  
        processorSchedulerClass.AddMethod("lowIOPriority", SCompiledMethod.CreateCompiledMethod(
            "lowIOPriority",
            [0x76, 0x7C], // Push 6, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // systemBackgroundPriority - returns 2
        processorSchedulerClass.AddMethod("systemBackgroundPriority", SCompiledMethod.CreateCompiledMethod(
            "systemBackgroundPriority",
            [0x72, 0x7C], // Push 2, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // timingPriority - returns 8
        processorSchedulerClass.AddMethod("timingPriority", SCompiledMethod.CreateCompiledMethod(
            "timingPriority",
            [0x78, 0x7C], // Push 8, return  
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // userBackgroundPriority - returns 3
        processorSchedulerClass.AddMethod("userBackgroundPriority", SCompiledMethod.CreateCompiledMethod(
            "userBackgroundPriority",
            [0x73, 0x7C], // Push 3, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // userInterruptPriority - returns 5
        processorSchedulerClass.AddMethod("userInterruptPriority", SCompiledMethod.CreateCompiledMethod(
            "userInterruptPriority",
            [0x75, 0x7C], // Push 5, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // userSchedulingPriority - returns 4
        processorSchedulerClass.AddMethod("userSchedulingPriority", SCompiledMethod.CreateCompiledMethod(
            "userSchedulingPriority",
            [0x74, 0x7C], // Push 4, return
            new SArray(),
            0, 0));
        instanceMethodCount++;
        
        // signal:atMilliseconds: - primitive 100
        processorSchedulerClass.AddMethod("signal:atMilliseconds:", SCompiledMethod.CreateCompiledMethod(
            "signal:atMilliseconds:",
            [0x70, 0xD0, 0x7C], // self primitiveFailed (fallback for primitive 100)
            SArray.From(SSymbol.Intern("primitiveFailed")),
            2, 0, 100));
        instanceMethodCount++;
        
        if (Program.RuntimeOptions?.EnableColdStartLogging ?? false)
        {
            Console.WriteLine($"[COLD START] ProcessorScheduler: {instanceMethodCount} instance methods installed");
        }
    }
    
