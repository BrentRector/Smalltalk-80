<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Smalltalk80.ExtractClass</AssemblyName>
    <RootNamespace>Smalltalk80.ExtractClass</RootNamespace>
    <Description>Smalltalk-80 Class Extractor - Extracts class definitions with compiled bytecode from system image</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smalltalk80\Smalltalk80.csproj" />
  </ItemGroup>

</Project>